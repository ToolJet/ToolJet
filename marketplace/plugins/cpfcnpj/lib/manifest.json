{
  "$schema": "https://raw.githubusercontent.com/ToolJet/ToolJet/develop/plugins/schemas/manifest.schema.json",
  "title": "CPF.CNPJ datasource",
  "description": "A schema defining CPF.CNPJ datasource",
  "type": "api",
  "source": {
    "name": "CPF.CNPJ",
    "kind": "cpfcnpj",
    "exposedVariables": {
      "isLoading": false,
      "data": {},
      "rawData": {}
    },
    "options": {
      "token": {
        "type": "string",
        "encrypted": true
      }
    }
  },
  "defaults": {},
  "properties": {
    "token": {
      "label": "API token",
      "key": "token",
      "type": "password",
      "description": "Enter your CPF.CNPJ API token",
      "hint": "Create a token at Panel > API > Tokens on cpfcnpj.com.br. The token is bound to the outbound IP address of your ToolJet server. A public test token that returns fictitious data is listed at https://www.cpfcnpj.com.br/dev/"
    }
  },
  "required": [
    "token"
  ]
}
