{
  "$schema": "https://raw.githubusercontent.com/ToolJet/ToolJet/develop/plugins/schemas/operations.schema.json",
  "title": "Cohere Datasource",
  "description": "A schema defining Cohere datasource",
  "type": "api",
  "defaults": {
    "operation": "text_generation"
  },
  "properties": {
    "operation": {
      "label": "Operation",
      "key": "operation",
      "type": "dropdown-component-flip",
      "description": "Select the operation to perform",
      "list": [
        { "value": "text_generation", "name": "Text Generation" },
        { "value": "chat", "name": "Chat" },
        { "value": "embed", "name": "Embed" },
        { "value": "rerank", "name": "Rerank" }
      ],
      "commonFields": {
        "model": {
          "label": "Model",
          "key": "model",
          "type": "dynamic-selector",
          "description": "Models are fetched from Cohere for the selected operation",
          "dependsOn": ["operation"],
          "fxEnabled": true,
          "autoFetch": true,
          "operation": {
            "invokeMethod": "listModels",
            "label": "Fetch Models"
          },
          "placeholder": "Select a model"
        }
      }
    },
    "text_generation": {
      "message": {
        "label": "Message",
        "key": "message",
        "type": "codehinter",
        "description": "Input the message for text generation",
        "placeholder": "Another one about generative AI.",
        "tooltip": "Next user prompt in the chat"
      },
      "advanced_parameters": {
        "label": "Advanced parameters",
        "key": "advanced_parameters",
        "type": "codehinter",
        "description": "Optional advanced parameters",
        "placeholder": "{\n    \"response_format\": {\"type\": \"text\"},\n    \"temperature\": 0.3,\n    \"max_tokens\": 256,\n    \"seed\": 3,\n    \"p\": 0.3,\n    \"k\": 1,\n    \"frequency_penalty\": 0.3,\n    \"presence_penalty\": 0.3,\n    \"citation_options\": {\"mode\": \"fast\"},\n    \"safety_mode\": \"CONTEXTUAL\",\n    \"stop_sequences\": [\"spam\", \"fraud\"]\n}"
      }
    },
    "chat": {
      "history": {
        "label": "History",
        "key": "history",
        "type": "codehinter",
        "description": "Input the conversation history",
        "placeholder": "[{\n  \"role\": \"system\",\n  \"content\": \"You are an SEO specialist content writer\"\n}, {\n  \"role\": \"user\",\n  \"content\": \"Write a title for a blog post about API design. Only output the title text.\"\n}, {\n  \"role\": \"assistant\",\n  \"content\": \"Designing Perfect APIs\"\n}]"
      },
      "message": {
        "label": "Message",
        "key": "message",
        "type": "codehinter",
        "description": "Input the message for text generation",
        "placeholder": "Another one about generative AI.",
        "tooltip": "Next user prompt in the chat"
      },
      "advanced_parameters": {
        "label": "Advanced parameters",
        "key": "advanced_parameters",
        "type": "codehinter",
        "description": "Optional advanced parameters",
        "placeholder": "{\n    \"response_format\": {\"type\": \"text\"},\n    \"temperature\": 0.3,\n    \"max_tokens\": 256,\n    \"seed\": 3,\n    \"p\": 0.3,\n    \"k\": 1,\n    \"frequency_penalty\": 0.3,\n    \"presence_penalty\": 0.3,\n    \"citation_options\": {\"mode\": \"fast\"},\n    \"safety_mode\": \"CONTEXTUAL\",\n    \"stop_sequences\": [\"spam\", \"fraud\"]\n}"
      }
    },
    "embed": {
      "texts": {
        "label": "Texts",
        "key": "texts",
        "type": "codehinter",
        "description": "Input the texts to embed as a JSON array of strings",
        "placeholder": "[\"What is the capital of France?\", \"How does photosynthesis work?\"]"
      },
      "input_type": {
        "label": "Input type",
        "key": "input_type",
        "type": "dropdown",
        "description": "Specifies the type of input passed to the model",
        "list": [
          { "value": "search_document", "name": "Search document" },
          { "value": "search_query", "name": "Search query" },
          { "value": "classification", "name": "Classification" },
          { "value": "clustering", "name": "Clustering" },
          { "value": "image", "name": "Image" }
        ]
      },
      "advanced_parameters": {
        "label": "Advanced parameters",
        "key": "advanced_parameters",
        "type": "codehinter",
        "description": "Optional advanced parameters",
        "placeholder": "{\n    \"embedding_types\": [\"float\"],\n    \"output_dimension\": 1024,\n    \"truncate\": \"END\"\n}"
      }
    },
    "rerank": {
      "query": {
        "label": "Query",
        "key": "query",
        "type": "codehinter",
        "description": "Input the search query",
        "placeholder": "What is the capital of the United States?"
      },
      "documents": {
        "label": "Documents",
        "key": "documents",
        "type": "codehinter",
        "description": "Input the documents to rerank as a JSON array of strings",
        "placeholder": "[\"Carson City is the capital city of the American state of Nevada.\", \"Washington, D.C. is the capital of the United States.\"]"
      },
      "advanced_parameters": {
        "label": "Advanced parameters",
        "key": "advanced_parameters",
        "type": "codehinter",
        "description": "Optional advanced parameters",
        "placeholder": "{\n    \"top_n\": 3,\n    \"max_tokens_per_doc\": 4096\n}"
      }
    }
  }
}
