{
  "$schema": "https://raw.githubusercontent.com/ToolJet/ToolJet/develop/plugins/schemas/operations.schema.json",
  "title": "Anakin datasource",
  "description": "A schema defining Anakin operations",
  "type": "api",
  "defaults": {
    "operation": "scrape_url"
  },
  "properties": {
    "operation": {
      "label": "Operation",
      "key": "operation",
      "type": "dropdown-component-flip",
      "description": "Single select dropdown for operation",
      "list": [
        {
          "value": "scrape_url",
          "name": "Extract Website Data"
        },
        {
          "value": "get_scrape_result",
          "name": "Get Scrape Result"
        },
        {
          "value": "map",
          "name": "Map a Site"
        },
        {
          "value": "get_map_result",
          "name": "Get Map Result"
        },
        {
          "value": "crawl",
          "name": "Crawl a Site"
        },
        {
          "value": "get_crawl_result",
          "name": "Get Crawl Result"
        },
        {
          "value": "search",
          "name": "Perform AI Search"
        },
        {
          "value": "agentic_search",
          "name": "Start Agentic Search"
        },
        {
          "value": "get_agentic_search_result",
          "name": "Get Agentic Search Result"
        },
        {
          "value": "wire_discover",
          "name": "Discover Wire Actions"
        },
        {
          "value": "wire_catalog",
          "name": "Browse Wire Catalog"
        },
        {
          "value": "wire_read_action",
          "name": "Run Wire Read Action"
        },
        {
          "value": "wire_write_action",
          "name": "Run Wire Write Action"
        },
        {
          "value": "get_wire_job_result",
          "name": "Get Wire Job Result"
        },
        {
          "value": "wire_identities",
          "name": "List Wire Identities"
        },
        {
          "value": "wire_login",
          "name": "Sign In To Wire Site"
        },
        {
          "value": "wire_build",
          "name": "Build A New Wire Action"
        },
        {
          "value": "wire_build_status",
          "name": "Check Wire Build Status"
        },
        {
          "value": "monitor_create",
          "name": "Create Website Monitor"
        },
        {
          "value": "monitor_list",
          "name": "List Website Monitors"
        },
        {
          "value": "monitor_changes",
          "name": "Get Monitor Changes"
        },
        {
          "value": "monitor_control",
          "name": "Control Website Monitor"
        },
        {
          "value": "ai_visibility_search",
          "name": "Start AI Visibility Search"
        },
        {
          "value": "get_ai_visibility_result",
          "name": "Get AI Visibility Result"
        },
        {
          "value": "ai_visibility_sources",
          "name": "List AI Visibility Sources"
        },
        {
          "value": "session_list",
          "name": "List Browser Sessions"
        },
        {
          "value": "session_delete",
          "name": "Delete Browser Session"
        },
        {
          "value": "browser_task",
          "name": "Run Browser Task"
        },
        {
          "value": "get_browser_task_result",
          "name": "Get Browser Task Result"
        }
      ]
    },
    "scrape_url": {
      "url": {
        "label": "URL",
        "key": "url",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The full URL of the website to extract data from",
        "placeholder": "{{'https://example.com'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "generate_json": {
        "label": "Generate JSON",
        "key": "generate_json",
        "type": "toggle",
        "description": "AI-extract structured JSON from the page content"
      },
      "country": {
        "label": "Country",
        "key": "country",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Proxy country code, e.g. us, gb, de",
        "placeholder": "{{'us'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "use_browser": {
        "label": "Use Browser",
        "key": "use_browser",
        "type": "toggle",
        "description": "Use a headless browser — best for JS-heavy sites"
      },
      "force_fresh": {
        "label": "Force Fresh",
        "key": "force_fresh",
        "type": "toggle",
        "description": "Bypass the cache and force a fresh extraction"
      },
      "session_id": {
        "label": "Session ID",
        "key": "session_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Saved browser session ID for login-protected pages. Pair with Use Browser.",
        "placeholder": "{{'sess_123'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "session_name": {
        "label": "Session Name",
        "key": "session_name",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Saved browser session name (alternative to Session ID)",
        "placeholder": "{{'my-login'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "get_scrape_result": {
      "job_id": {
        "label": "Job ID",
        "key": "job_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The jobId returned by Extract Website Data",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      }
    },
    "map": {
      "url": {
        "label": "URL",
        "key": "url",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The starting URL for discovery (typically a homepage or section root)",
        "placeholder": "{{'https://example.com'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "limit": {
        "label": "Limit",
        "key": "limit",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Maximum number of URLs to return overall (default 100, max 1000)",
        "placeholder": "100",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "depth": {
        "label": "Depth",
        "key": "depth",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "How many link-hops from the starting URL to follow (default 2, max 5)",
        "placeholder": "2",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "limit_per_level": {
        "label": "Limit Per Level",
        "key": "limit_per_level",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Maximum URLs collected per depth level (default 100)",
        "placeholder": "100",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "include_subdomains": {
        "label": "Include Subdomains",
        "key": "include_subdomains",
        "type": "toggle",
        "description": "Include URLs on subdomains of the starting host"
      },
      "include_external_links": {
        "label": "Include External Links",
        "key": "include_external_links",
        "type": "toggle",
        "description": "Also collect (but do not follow) external links"
      },
      "use_browser": {
        "label": "Use Browser",
        "key": "use_browser",
        "type": "toggle",
        "description": "Render with a headless browser (for SPAs)"
      },
      "search": {
        "label": "Search Filter",
        "key": "search",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional keyword filter — only return URLs whose path/title matches",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "get_map_result": {
      "job_id": {
        "label": "Job ID",
        "key": "job_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The jobId returned by Map a Site",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      }
    },
    "crawl": {
      "url": {
        "label": "URL",
        "key": "url",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Starting URL",
        "placeholder": "{{'https://example.com'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "max_pages": {
        "label": "Max Pages",
        "key": "max_pages",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Hard cap on pages fetched (default 10, max 500)",
        "placeholder": "10",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "depth": {
        "label": "Depth",
        "key": "depth",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Link-hops from the starting URL to follow (default 1, max 5)",
        "placeholder": "1",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "country": {
        "label": "Country",
        "key": "country",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Two-letter proxy egress country code",
        "placeholder": "{{'us'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "use_browser": {
        "label": "Use Browser",
        "key": "use_browser",
        "type": "toggle",
        "description": "Render each page in a headless browser (for SPAs)"
      },
      "include_patterns": {
        "label": "Include Patterns",
        "key": "include_patterns",
        "type": "codehinter",
        "description": "Glob/regex patterns — only URLs matching at least one pattern are fetched",
        "placeholder": "{{['/blog/*']}}",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "editorType": "extendedSingleLine"
      },
      "exclude_patterns": {
        "label": "Exclude Patterns",
        "key": "exclude_patterns",
        "type": "codehinter",
        "description": "Glob/regex patterns — URLs matching any pattern are skipped",
        "placeholder": "{{['/admin/*']}}",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "editorType": "extendedSingleLine"
      },
      "session_id": {
        "label": "Session ID",
        "key": "session_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional saved-browser-session ID for login-protected sites",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "session_name": {
        "label": "Session Name",
        "key": "session_name",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional saved-browser-session name",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "get_crawl_result": {
      "job_id": {
        "label": "Job ID",
        "key": "job_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The jobId returned by Crawl a Site",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      }
    },
    "search": {
      "prompt": {
        "label": "Search query",
        "key": "prompt",
        "type": "codehinter",
        "description": "The search query or question",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "limit": {
        "label": "Max results",
        "key": "limit",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Maximum number of results to return (default 5, max 20)",
        "placeholder": "5",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "agentic_search": {
      "prompt": {
        "label": "Research prompt",
        "key": "prompt",
        "type": "codehinter",
        "description": "The research question or topic (max 8KB)",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "use_browser": {
        "label": "Use Browser",
        "key": "use_browser",
        "type": "toggle",
        "description": "Use a headless browser for citation scraping — matches the API default"
      },
      "schema": {
        "label": "Result schema (JSON)",
        "key": "schema",
        "type": "codehinter",
        "description": "Optional JSON Schema (max 50KB) for the structured output",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "editorType": "extendedSingleLine"
      }
    },
    "get_agentic_search_result": {
      "job_id": {
        "label": "Job ID",
        "key": "job_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The job_id returned by Start Agentic Search",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      }
    },
    "wire_discover": {
      "q": {
        "label": "Intent",
        "key": "q",
        "type": "codehinter",
        "description": "The intent in natural language, e.g. \"top phones on walmart\", \"search airbnb listings in Lisbon\"",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "limit": {
        "label": "Limit",
        "key": "limit",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Maximum number of candidate actions to return (default 5)",
        "placeholder": "5",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "wire_catalog": {
      "slug": {
        "label": "Catalog Slug",
        "key": "slug",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Catalog slug to inspect (e.g. \"walmart\"). Omit to list all catalogs",
        "placeholder": "{{'walmart'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "wire_read_action": {
      "action_id": {
        "label": "Action ID",
        "key": "action_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The Wire action to run (from Discover Wire Actions / Browse Wire Catalog), e.g. \"walmart.search_products\"",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "params": {
        "label": "Params",
        "key": "params",
        "type": "codehinter",
        "description": "The action's input parameters — shape depends on the action, see its schema from discovery. Omit for actions that take none",
        "placeholder": "{{ { query: 'wireless headphones' } }}",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "editorType": "extendedSingleLine"
      },
      "credential_id": {
        "label": "Credential ID",
        "key": "credential_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Required when the action's auth_mode is \"required\"; honored when \"optional\". Get one from List Wire Identities or Sign In To Wire Site",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "identity_id": {
        "label": "Identity ID",
        "key": "identity_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional identity selector — the server resolves a credential from it (alternative to Credential ID)",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "wire_write_action": {
      "action_id": {
        "label": "Action ID",
        "key": "action_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The Wire action to run (from Discover Wire Actions / Browse Wire Catalog), e.g. \"amazon.add_to_cart\". Never a payment/checkout action — Anakin's API and this plugin both refuse those",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "params": {
        "label": "Params",
        "key": "params",
        "type": "codehinter",
        "description": "The action's input parameters — shape depends on the action, see its schema from discovery. Omit for actions that take none",
        "placeholder": "{{ { product_id: '12345', quantity: 1 } }}",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "editorType": "extendedSingleLine"
      },
      "credential_id": {
        "label": "Credential ID",
        "key": "credential_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Required when the action's auth_mode is \"required\"; honored when \"optional\". Get one from List Wire Identities or Sign In To Wire Site",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "identity_id": {
        "label": "Identity ID",
        "key": "identity_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional identity selector — the server resolves a credential from it (alternative to Credential ID)",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "get_wire_job_result": {
      "job_id": {
        "label": "Job ID",
        "key": "job_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The job_id returned by Run Wire Read Action / Run Wire Write Action (only present when the action ran asynchronously)",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      }
    },
    "wire_identities": {
      "catalog_id": {
        "label": "Catalog ID",
        "key": "catalog_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional — restrict to identities for a single catalog",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      }
    },
    "wire_login": {
      "catalog_slug": {
        "label": "Catalog Slug",
        "key": "catalog_slug",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The catalog to sign in to (e.g. \"neb\")",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "params": {
        "label": "Login Params",
        "key": "params",
        "type": "codehinter",
        "description": "Login fields defined by the catalog (e.g. email/password). Use Browse Wire Catalog's login_input_schema to learn the field names",
        "placeholder": "{{ { email: 'you@example.com', password: 'secret' } }}",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "editorType": "extendedSingleLine"
      },
      "identity_name": {
        "label": "Identity Name",
        "key": "identity_name",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional name for the identity. Derived from params in password mode; required when using a 1Password locator",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "source_id": {
        "label": "Source ID",
        "key": "source_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional 1Password identity-source ID (alternative to Login Params)",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "source_ref": {
        "label": "Source Ref",
        "key": "source_ref",
        "type": "codehinter",
        "description": "Optional 1Password item locator { vault_id, item_id, fields } (use with Source ID instead of Login Params)",
        "placeholder": "{{ { vault_id: '...', item_id: '...' } }}",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "editorType": "extendedSingleLine"
      }
    },
    "wire_build": {
      "website_url": {
        "label": "Website URL",
        "key": "website_url",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "The site to build an action for. The domain is extracted automatically",
        "placeholder": "{{'https://example.com'}}",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "goal": {
        "label": "Goal",
        "key": "goal",
        "type": "codehinter",
        "description": "Natural-language description of what the action should do or extract. Be specific — the builder synthesizes the scraper from this",
        "height": "150px",
        "className": "codehinter-plugins",
        "lineNumbers": false,
        "width": "320px",
        "mandatory": true,
        "editorType": "extendedSingleLine"
      },
      "catalog_id": {
        "label": "Catalog ID",
        "key": "catalog_id",
        "type": "codehinter",
        "lineNumbers": false,
        "description": "Optional — attach to an existing catalog instead of creating one",
        "width": "320px",
        "height": "36px",
        "className": "codehinter-plugins",
        "editorType": "extendedSingleLine"
      },
      "visibility": {
        "label": "Visibility",
        "key": "visibility",
        "type": "dropdown",
        "description": "Action visibility. Defaults to private",
        "list": [
          {
            "value": "private",
            "name": "Private"
          },
          {
            "value": "public",
            "name": "Public"
          }
        ]
      },
      "force": {
        "label": "Force",
        "key": "force",
        "type": "toggle",
        "description": "Build even if similar actions already exist for the domain (otherwise rejected with ACTION_EXISTS)"
      },
      "actions": {
        "label": "Actions",
        "key": "actions",
        "type": "codehinter",
