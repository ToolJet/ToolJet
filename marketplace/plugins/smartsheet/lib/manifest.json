{
  "$schema": "https://raw.githubusercontent.com/ToolJet/ToolJet/develop/plugins/schemas/manifest.schema.json",
  "title": "Smartsheet datasource",
  "description": "A schema defining Smartsheet datasource",
  "type": "api",
  "source": {
    "name": "Smartsheet",
    "kind": "smartsheet",
    "exposedVariables": {
      "isLoading": false,
      "data": {},
      "rawData": {}
    },
    "customTesting": false,
    "options": {
      "client_id": {
        "type": "string"
      },
      "client_secret": {
        "type": "string",
        "encrypted": true
      },
      "redirect_url": {
        "type": "string"
      },
      "access_token_url": {
        "type": "string"
      },
      "auth_url": {
        "type": "string"
      },
      "scopes": {
        "type": "string"
      },
      "access_token": {
        "type": "string",
        "encrypted": true
      },
      "refresh_token": {
        "type": "string",
        "encrypted": true
      },
      "region": {
        "type": "string"
      }
    }
  },
  "defaults": {
    "auth_type": {
      "value": "oauth2"
    },
    "allowed_auth_types": {
      "value": "oauth2 personal_access_token"
    },
    "grant_type": {
      "value": "authorization_code"
    },
    "redirect_url": {
      "value": ""
    },
    "scopes": {
      "value": "READ_SHEETS WRITE_SHEETS CREATE_SHEETS READ_USERS ADMIN_USERS READ_CONTACTS ADMIN_WEBHOOKS"
    },
    "region": {
      "value": "us"
    }
  },
  "properties": {
    "credentials": {
      "label": "Authentication",
      "key": "auth_type",
      "type": "dropdown-component-flip",
      "description": "Choose how ToolJet authenticates with Smartsheet",
      "list": [
        {
          "value": "oauth2",
          "name": "OAuth 2.0"
        },
        {
          "value": "personal_access_token",
          "name": "API Access Token"
        }
      ],
      "commonFields": {
        "region": {
          "label": "Region",
          "key": "region",
          "type": "dropdown",
          "description": "Select the Smartsheet region",
          "list": [
            {
              "name": "US",
              "value": "us"
            },
            {
              "name": "EU",
              "value": "eu"
            },
            {
              "name": "AU",
              "value": "au"
            }
          ]
        }
      }
    },
    "oauth2": {
      "oauth": {
        "key": "oauth",
        "type": "react-component-oauth",
        "description": "OAuth configuration for Smartsheet",
        "oauth_configs": {
          "allowed_field_groups": {
            "authorization_code": ["client_id", "client_secret"]
          },
          "allowed_auth_types": ["oauth2"],
          "allowed_grant_types": ["authorization_code"],
          "allowed_scope_field": true,
          "scopeHelperText": "Space-separated Smartsheet scopes. These must also be added to your Smartsheet app under OAuth. The authorization and token endpoints come from the selected region."
        }
      }
    },
    "personal_access_token": {
      "access_token": {
        "label": "API Access Token",
        "key": "access_token",
        "type": "password",
        "description": "Enter a Smartsheet API token",
        "encrypted": true
      }
    }
  },
  "required": []
}
