{
  "$schema": "https://raw.githubusercontent.com/ToolJet/ToolJet/develop/plugins/schemas/manifest.schema.json",
  "title": "Salesforce datasource",
  "description": "A schema defining Salesforce datasource",
  "version": "1.2.0",
  "type": "api",
  "source": {
    "name": "Salesforce",
    "kind": "salesforce",
    "exposedVariables": {
      "isLoading": false,
      "data": {},
      "rawData": {}
    },
    "options": {
      "client_id": {
        "type": "string"
      },
      "client_secret": {
        "type": "string",
        "encrypted": true
      },
      "code": {
        "type": "string",
        "encrypted": true
      },
      "redirect_url": {
        "type": "string"
      },
      "api_version": {
        "type": "string"
      },
      "provider": {
        "type": "string"
      },
      "oauth2": {
        "type": "boolean"
      },
      "plugin_id": {
        "type": "string"
      },
      "auth_type": {
        "type": "string"
      },
      "grant_type": {
        "type": "string"
      },
      "scopes": {
        "type": "string"
      },
      "code_verifier": {
        "type": "string"
      },
      "code_challenge_method": {
        "type": "string"
      },
      "login_type": {
        "type": "string"
      },
      "custom_domain": {
        "type": "string"
      }
    },
    "customTesting": true,
    "hideSave": true
  },
  "defaults": {
    "redirect_url": {
      "value": ""
    },
    "auth_type": {
      "value": "oauth2"
    },
    "grant_type": {
      "value": "authorization_code"
    },
    "scopes": {
      "value": "full"
    },
    "oauth_type": {
      "value": "custom_app"
    },
    "code_challenge_method": {
      "value": "S256"
    },
    "login_type": {
      "value": "production"
    }
  },
  "properties": {
    "api_version": {
      "label": "API version",
      "key": "api_version",
      "type": "dropdown",
      "description": "Single select dropdown for api version",
      "list": [
        {
          "name": "v1",
          "value": "v1"
        },
        {
          "name": "v2",
          "value": "v2"
        }
      ]
    },
    "login_type": {
      "label": "Login type",
      "key": "login_type",
      "type": "dropdown",
      "description": "Salesforce login host used for authorization",
      "list": [
        {
          "name": "Production",
          "value": "production"
        },
        {
          "name": "Sandbox",
          "value": "sandbox"
        },
        {
          "name": "Custom domain",
          "value": "custom_domain"
        }
      ]
    },
    "custom_domain": {
      "label": "Custom domain",
      "key": "custom_domain",
      "type": "text",
      "description": "mycompany.my.salesforce.com or any https login host (used only when Login type is Custom domain)"
    },
    "oauth": {
      "label": "",
      "key": "oauth",
      "type": "react-component-oauth",
      "description": "A component for Salesforce",
      "oauth_configs": {
        "allowed_auth_types": [
          "oauth2"
        ],
        "allowed_grant_types": [
          "authorization_code",
          "authorization_code_pkce"
        ],
        "allowed_field_groups": {
          "authorization_code": [
            "client_id",
            "client_secret",
            "scopes"
          ],
          "authorization_code_pkce": [
            "client_id",
            "client_secret",
            "scopes",
            "code_challenge_method",
            "code_verifier"
          ]
        },
        "oauthTypes": {
          "required": true,
          "default_value": "custom_app",
          "editions": {
            "ce": [
              "custom_app"
            ],
            "ee": [
              "custom_app"
            ],
            "cloud": [
              "custom_app",
              "tooljet_app"
            ]
          }
        },
        "show_auth_type_dropdown": true
      }
    }
  },
  "required": []
}
