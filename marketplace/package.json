{
  "name": "tooljet-marketplace",
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "version": "1.0.0",
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^5.57.0",
    "@typescript-eslint/parser": "^5.57.0",
    "ajv": "^6.15.0",
    "eslint": "^8.37.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-jest": "^27.2.1",
    "eslint-plugin-prettier": "^4.2.1",
    "js-yaml": "^4.1.1",
    "lerna": "^10.1.1",
    "mime-types": "^2.1.35",
    "prettier": "^2.8.7",
    "recursive-readdir": "^2.2.3",
    "ts-jest": "^29.0.5"
  },
  "overrides": {
    "axios": "^1.20.0",
    "tar": "^7.5.22",
    "websocket-driver": "^0.7.5",
    "handlebars": "^4.7.10",
    "follow-redirects": "^1.16.2",
    "zod": "^4.6.6",
    "smol-toml": "^1.9.0",
    "undici": "^7.30.1",
    "external-editor": {
      "tmp": "^0.2.6"
    }
  },
  "peerDependencies": {
    "typescript": "^4.9.5"
  },
  "scripts": {
    "start:watch": "lerna run watch --stream --parallel",
    "build": "npm run build --workspaces",
    "start:dev": "npm run build && npm run start:watch",
    "upload-to-s3": "bash scripts/upload-to-s3.sh",
    "lint": "eslint .  '**/*.ts'",
    "validate:plugin": "node scripts/validate-plugin.js",
    "format": "eslint . --fix '**/*.ts'"
  }
