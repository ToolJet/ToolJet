{
  "$schema": "https://raw.githubusercontent.com/ToolJet/ToolJet/develop/plugins/schemas/manifest.schema.json",
  "title": "{{PLUGIN_TITLE}} datasource",
  "description": "A schema defining {{PLUGIN_TITLE}} datasource",
  "type": "api",
  "source": {
    "name": "{{PLUGIN_NAME}}",
    "kind": "{{PLUGIN_KIND}}",
    "exposedVariables": {
      "isLoading": false,
      "data": {},
      "rawData": {}
    },
    "options": {
      "client_id": {
        "type": "string"
      },
      "client_secret": {
        "type": "string",
        "encrypted": true
      }
    },
    "customTesting": true
  },
  "defaults": {
    "client_id": {
      "value": ""
    },
    "client_secret": {
      "value": ""
    },
    "oauth_type": {
      "value": "custom_app"
    },
    "auth_url": {
      "value": "{{AUTHORIZATION_URL}}"
    },
    "access_token_url": {
      "value": "{{TOKEN_URL}}"
    },
    "redirect_url": {
      "value": ""
    },
    "allowed_auth_types": {
      "value": "oauth2"
    },
    "auth_type": {
      "value": "oauth2"
    },
    "grant_type": {
      "value": "authorization_code"
    },
    "access_token_custom_headers": {
      "value": [
        [
          "Content-Type",
          "application/x-www-form-urlencoded"
        ]
      ]
    },
    "scopes": {
      "value": "{{DEFAULT_SCOPES}}"
    }
  },
  "properties": {
    "oauth": {
      "key": "oauth",
      "type": "react-component-oauth",
      "description": "OAuth 2.0 authentication for {{PLUGIN_NAME}}",
      "oauth_configs": {
        "allowed_field_groups": {
          "authorization_code": [
            "client_id",
            "client_secret"
          ]
        },
        "allowed_auth_types": [
          "oauth2"
        ],
        "allowed_grant_types": [
          "authorization_code"
        ],
        "allowed_scope_field": true
      }
    }
  },
  "required": [
    "client_id",
    "client_secret"
  ]
}
