{
  "$schema": "https://raw.githubusercontent.com/ToolJet/ToolJet/develop/plugins/schemas/manifest.schema.json",
  "title": "{{PLUGIN_TITLE}} datasource",
  "description": "A schema defining {{PLUGIN_TITLE}} datasource",
  "type": "api",
  "source": {
    "name": "{{PLUGIN_NAME}}",
    "kind": "{{PLUGIN_KIND}}",
    "exposedVariables": {
      "isLoading": false,
      "data": {},
      "rawData": {}
    },
    "options": {
      "base_url": {
        "type": "string"
      },
      "headers": {
        "type": "array"
      }
    },
    "customTesting": false
  },
  "defaults": {
    "base_url": {
      "value": ""
    },
    "headers": {
      "value": [
        [
          "",
          ""
        ]
      ]
    }
  },
  "properties": {
    "base_url": {
      "label": "Base URL",
      "key": "base_url",
      "type": "text",
      "description": "Enter the API base URL"
    },
    "headers": {
      "label": "Headers",
      "key": "headers",
      "type": "react-component-headers",
      "description": "Headers sent with every request"
    }
  },
  "required": [
    "base_url"
  ]
}
