{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "{{PLUGIN_TITLE}} datasource",
  "description": "A schema defining {{PLUGIN_TITLE}} datasource",
  "type": "object",
  "tj:version": "1.0.0",
  "tj:source": {
    "name": "{{PLUGIN_NAME}}",
    "kind": "{{PLUGIN_KIND}}",
    "type": "database"
  },
  "tj:encrypted": [
    "password"
  ],
  "properties": {
    "host": {
      "type": "string",
      "title": "Host",
      "description": "Enter host",
      "default": "localhost"
    },
    "port": {
      "type": "number",
      "title": "Port",
      "description": "Enter port"
    },
    "database": {
      "type": "string",
      "title": "Database name",
      "description": "Name of the database"
    },
    "username": {
      "type": "string",
      "title": "Username",
      "description": "Enter username"
    },
    "password": {
      "type": "string",
      "title": "Password",
      "description": "Enter password"
    },
    "ssl_enabled": {
      "type": "boolean",
      "title": "SSL/TLS",
      "description": "Connect using SSL",
      "default": false
    }
  },
  "required": [
    "host",
    "port",
    "username",
    "password"
  ],
  "tj:ui:properties": {
    "host": {
      "order": 1,
      "$ref": "#/properties/host",
      "key": "host",
      "label": "Host",
      "widget": "text-v3",
      "required": true
    },
    "port": {
      "order": 2,
      "$ref": "#/properties/port",
      "key": "port",
      "label": "Port",
      "widget": "text-v3",
      "required": true
    },
    "database": {
      "order": 3,
      "$ref": "#/properties/database",
      "key": "database",
      "label": "Database",
      "widget": "text-v3"
    },
    "username": {
      "order": 4,
      "$ref": "#/properties/username",
      "key": "username",
      "label": "Username",
      "widget": "text-v3",
      "required": true
    },
    "password": {
      "order": 5,
      "$ref": "#/properties/password",
      "key": "password",
      "label": "Password",
      "widget": "password-v3",
      "required": true,
      "help_text": "Supports secrets (e.g.,{{secrets.db_password}})"
    },
    "ssl_enabled": {
      "order": 6,
      "$ref": "#/properties/ssl_enabled",
      "key": "ssl_enabled",
      "label": "SSL/TLS",
      "widget": "toggle-v2",
      "help_text": "Enable encrypted connections"
    }
  }
}
