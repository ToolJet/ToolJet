<table align="center" class="content-body">
  <tr>
    <td class="content-body_wrap padding-x-40">
      <table>
        <tr>
          <td>
            <p>
              {{#if reminder}}
                This is a reminder that an approval request is waiting for your decision.
              {{else}}
                A workflow approval request is waiting for your decision.
              {{/if}}
            </p>
          </td>
        </tr>
        <tr>
          <td class="padding-t-20">
            <table style="background-color: #F6F8FA; border-radius: 6px;">
              <tr>
                <td class="padding-20">
                  <p style="color: #687076; font-size: 12px; line-height: 18px;">WORKFLOW</p>
                  <p class="text-bold">{{workflowName}}</p>
                  <p style="color: #687076; font-size: 12px; line-height: 18px; padding-top: 12px;">APPROVAL STEP</p>
                  <p class="text-bold">{{nodeName}}</p>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        {{#if description}}
          <tr>
            <td class="padding-t-20">
              <p>{{description}}</p>
            </td>
          </tr>
        {{/if}}
        <tr>
          <td class="padding-y-20">
            <a href="{{approvalDashboardUrl}}" target="_blank" class="padding-r-40">
              <button class="primary-btn">Open approval dashboard</button>
            </a>
          </td>
        </tr>
        <tr>
          <td class="padding-y-10">
            <p style="font-size: 14px; color: #555;">
              If the button isn't accessible, copy and paste this link into your browser:
              <br />
              <span style="color: #555; word-break: break-all;">{{approvalDashboardUrl}}</span>
            </p>
          </td>
        </tr>
        <tr>
          <td class="padding-y-10 footer-note">
            {{#if (eq whiteLabelText "ToolJet")}}
              <span>Thanks,</span>
              <br />
              <span>The ToolJet Team</span>
            {{else}}
              <span>Thanks!</span>
            {{/if}}
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
