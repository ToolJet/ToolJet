  "validation": {},
  "events": [
    "onClick"
  ],
  "actions": {
    "clearImage": [],
    "setDisable": [
      "value"
    ],
    "setImageURL": [
      "url"
    ],
    "setLoading": [
      "value"
    ],
    "setVisibility": [
      "value"
    ]
  },
  "exposed": [
    "alternativeText",
    "hasError",
    "imageURL",
    "isDisabled",
    "isLoading",
    "isVisible"
  ]
