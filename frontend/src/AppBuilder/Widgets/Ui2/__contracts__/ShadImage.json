{
  "type": "ShadImage",
  "properties": {
    "alternativeText": {
      "type": "string",
      "default": "",
      "initial": "Mountain lake at sunrise"
    },
    "aspectRatio": {
      "type": "string",
      "default": "auto",
      "initial": "auto"
    },
    "caption": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "dynamicHeight": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "fallback": {
      "type": "string",
      "default": "placeholder",
      "initial": "placeholder"
    },
    "fallbackText": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "imageFit": {
      "type": "string",
      "default": "cover",
      "initial": "cover"
    },
    "loadingIndicator": {
      "type": "string",
      "default": "spinner",
      "initial": "spinner"
    },
    "loadingState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "showBorder": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "source": {
      "type": "string",
      "default": "",
      "initial": "https://images.unsplash.com/photo-1506744038136-46273834b3fb?w=800"
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "zoomOnClick": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    }
