  "styles": {
    "backgroundColor": {
      "type": "string"
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "union<string|number>"
    },
    "boxShadow": {
      "type": "union<string|number>",
      "default": "0px 0px 0px 0px #00000040",
      "initial": "0px 0px 0px 0px #00000040"
    },
    "captionColor": {
      "type": "string"
    },
    "fallbackTextColor": {
      "type": "string"
    }
