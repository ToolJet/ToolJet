{
  "type": "ShadTagsInput",
  "properties": {
    "addOnBlur": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "allowCustomTags": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "caseSensitive": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "defaultValue": {
      "type": "array",
      "default": [],
      "initial": "{{['react', 'typescript']}}"
    },
    "description": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "dynamicHeight": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "label": {
      "type": "string",
      "default": "",
      "initial": "Tags"
    },
    "loadingState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "maxTags": {
      "type": "union<string|number>",
      "default": 0,
      "initial": "{{0}}"
    },
    "patternError": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "placeholder": {
      "type": "string",
      "default": "Add a tag...",
      "initial": "Add a tag..."
    },
    "showClearBtn": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "suggestions": {
      "type": "array",
      "default": [],
      "initial": "{{['react', 'typescript', 'node', 'python', 'design', 'devops']}}"
    },
    "tagPattern": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    }
  },
  "styles": {
    "accentColor": {
      "type": "string"
    },
    "backgroundColor": {
      "type": "string"
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "union<string|number>"
    },
    "boxShadow": {
      "type": "union<string|number>",
      "default": "0px 0px 0px 0px #00000040",
      "initial": "0px 0px 0px 0px #00000040"
    },
    "chipBackgroundColor": {
      "type": "string"
    },
    "chipTextColor": {
      "type": "string"
    },
    "errorColor": {
      "type": "string"
    },
    "helpTextColor": {
      "type": "string"
    },
    "labelColor": {
      "type": "string"
    },
    "menuBackgroundColor": {
      "type": "string"
    },
    "menuTextColor": {
      "type": "string"
    },
    "optionHoverColor": {
      "type": "string"
    },
    "placeholderColor": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    }
  },
  "validation": {
    "customRule": {
      "initial": ""
    },
    "mandatory": {
      "initial": "{{false}}"
    }
  },
  "events": [
    "onBlur",
    "onChange",
    "onFocus",
    "onTagAdded",
    "onTagDeleted"
  ],
  "actions": {
    "clear": [],
    "deselectTags": [
      "tags"
    ],
    "selectTags": [
      "tags"
    ],
    "setBlur": [],
    "setDisable": [
      "value"
    ],
    "setFocus": [],
    "setLoading": [
      "value"
    ],
    "setTags": [
      "tags"
    ],
    "setVisibility": [
      "value"
    ]
  },
  "exposed": [
    "isDisabled",
    "isLoading",
    "isMandatory",
    "isValid",
    "isVisible",
    "label",
    "lastAddedTag",
    "lastRemovedTag",
    "newTagsAdded",
    "values"
  ]
}
