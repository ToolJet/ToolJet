{
  "type": "ShadBreadcrumb",
  "properties": {
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "items": {
      "type": "array",
      "default": [],
      "initial": "{{['Home', 'Section', 'Page']}}"
    },
    "loadingIndicator": {
      "type": "string",
      "default": "spinner",
      "initial": "spinner"
    },
    "loadingState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    }
  },
  "styles": {
    "boxShadow": {
      "type": "union<string|number>",
      "default": "0px 0px 0px 0px #00000040",
      "initial": "0px 0px 0px 0px #00000040"
    },
    "currentColor": {
      "type": "string"
    },
    "separatorColor": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    }
  },
  "validation": {},
  "events": [
    "onItemClicked"
  ],
  "actions": {
    "setDisable": [
      "value"
    ],
    "setLoading": [
      "value"
    ],
    "setVisibility": [
      "value"
    ]
  },
  "exposed": [
    "isDisabled",
    "isLoading",
    "isVisible",
    "lastClickedItem"
  ]
}
