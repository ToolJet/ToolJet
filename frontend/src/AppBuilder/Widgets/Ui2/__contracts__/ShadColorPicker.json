{
  "type": "ShadColorPicker",
  "properties": {
    "allowAlpha": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "defaultValue": {
      "type": "string",
      "default": "#6366f1",
      "initial": "#6366f1"
    },
    "description": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "dynamicHeight": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "label": {
      "type": "string",
      "default": "",
      "initial": "Brand color"
    },
    "loadingState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "placeholder": {
      "type": "string",
      "default": "Pick a color",
      "initial": "Pick a color"
    },
    "showPicker": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "showSwatches": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "swatches": {
      "type": "array",
      "default": [],
      "initial": "{{['#0f172a', '#64748b', '#ef4444', '#f97316', '#f59e0b', '#eab308', '#84cc16', '#22c55e', '#10b981', '#14b8a6', '#06b6d4', '#3b82f6', '#6366f1', '#8b5cf6', '#d946ef', '#ec4899']}}"
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "triggerStyle": {
      "type": "string",
      "default": "field",
      "initial": "field"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    }
  },
  "styles": {
    "accentColor": {
      "type": "string"
    },
    "backgroundColor": {
      "type": "string"
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "union<string|number>"
    },
    "boxShadow": {
      "type": "union<string|number>",
      "default": "0px 0px 0px 0px #00000040",
      "initial": "0px 0px 0px 0px #00000040"
    },
    "helpTextColor": {
      "type": "string"
    },
    "labelColor": {
      "type": "string"
    },
    "menuBackgroundColor": {
      "type": "string"
    },
    "placeholderColor": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    }
  },
  "validation": {},
  "events": [
    "onBlur",
    "onChange",
    "onFocus"
  ],
  "actions": {
    "setBlur": [],
    "setColor": [
      "color"
    ],
    "setDisable": [
      "value"
    ],
    "setFocus": [],
    "setLoading": [
      "value"
    ],
    "setVisibility": [
      "value"
    ]
  },
  "exposed": [
    "allowOpacity",
    "colorFormat",
    "isDisabled",
    "isLoading",
    "isValid",
    "isVisible",
    "label",
    "selectedColorRGB",
    "selectedColorRGBA",
    "value"
  ]
