      "initial": "0px 0px 0px 0px #00000040"
    },
    "textColor": {
      "type": "string"
    },
    "titleColor": {
      "type": "string"
    }
  },
  "validation": {},
  "events": [],
  "actions": {
    "setDisable": [
      "value"
    ],
    "setLoading": [
      "value"
    ],
    "setVisibility": [
      "value"
    ]
