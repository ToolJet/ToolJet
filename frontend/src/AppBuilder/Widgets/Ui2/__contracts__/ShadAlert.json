{
  "type": "ShadAlert",
  "properties": {
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "description": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "dynamicHeight": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "loadingIndicator": {
      "type": "string",
      "default": "spinner",
      "initial": "spinner"
    },
