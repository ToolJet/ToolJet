      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "title": {
      "type": "string",
      "default": "Heads up",
      "initial": "Heads up"
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "variant": {
      "type": "string",
      "default": "default",
      "initial": "default"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    }
