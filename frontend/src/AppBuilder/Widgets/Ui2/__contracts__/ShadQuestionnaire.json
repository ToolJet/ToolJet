{
  "type": "ShadQuestionnaire",
  "properties": {
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "completeText": {
      "type": "string",
      "default": "",
      "initial": "We will use them to set up your workspace."
    },
    "completeTitle": {
      "type": "string",
      "default": "Thanks for your answers",
      "initial": "Thanks for your answers"
    },
    "defaultAnswers": {
      "type": "object",
      "default": {},
      "initial": "{{{}}}"
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "dynamicHeight": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "items": {
      "type": "array",
      "default": [],
      "initial": "{{[\n  { name: 'role', prompt: 'What best describes your role?', required: true, type: 'single', choices: [{ label: 'Operations', description: 'Run day-to-day work' }, { label: 'Finance' }, { label: 'Engineering' }], other: true },\n  { name: 'goals', prompt: 'What do you want to get done first?', description: 'Pick all that apply.', type: 'multiple', choices: ['Track orders', 'Approve requests', 'Report on spend'] },\n  { name: 'notes', prompt: 'Anything else we should know?', type: 'text', placeholder: 'Optional' }\n]}}"
    },
    "loadingState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "shortcuts": {
      "type": "string",
      "default": "letters",
      "initial": "letters"
    },
    "showProgress": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "submitLabel": {
      "type": "string",
      "default": "Submit",
      "initial": "Submit"
    },
    "surface": {
      "type": "string",
      "default": "card",
      "initial": "card"
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    }
  },
  "styles": {
    "accentColor": {
      "type": "string"
    },
    "backgroundColor": {
      "type": "string"
    },
    "borderColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "union<string|number>"
    },
    "boxShadow": {
      "type": "union<string|number>",
      "default": "0px 0px 0px 0px #00000040",
      "initial": "0px 0px 0px 0px #00000040"
    },
    "textColor": {
      "type": "string"
    },
    "titleColor": {
      "type": "string"
    },
    "titleFontFamily": {
      "type": "string",
      "default": "theme",
      "initial": "theme"
    }
  },
  "validation": {},
  "events": [
    "onStepChanged",
    "onSubmit"
  ],
  "actions": {
    "goTo": [
      "index"
    ],
    "reset": [],
    "setDisable": [
      "value"
    ],
    "setLoading": [
      "value"
    ],
    "setVisibility": [
      "value"
    ]
  },
  "exposed": [
    "answers",
    "currentIndex",
    "currentItem",
    "isComplete",
    "isDisabled",
    "isLoading",
    "isVisible"
  ]
}
