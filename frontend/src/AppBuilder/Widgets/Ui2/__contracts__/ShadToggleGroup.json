{
  "type": "ShadToggleGroup",
  "properties": {
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "defaultValue": {
      "type": "union<string|number|boolean|array|object>",
      "default": "",
      "initial": "All"
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "fullWidth": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "loadingState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "options": {
      "type": "array",
      "default": [],
      "initial": "{{['All', 'Open', 'Closed']}}"
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    }
  },
  "styles": {
    "backgroundColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "union<string|number>"
    },
    "boxShadow": {
      "type": "union<string|number>",
      "default": "0px 0px 0px 0px #00000040",
      "initial": "0px 0px 0px 0px #00000040"
    },
    "selectedBackgroundColor": {
      "type": "string"
    },
    "selectedTextColor": {
      "type": "string"
    },
    "textColor": {
      "type": "string"
    }
  },
  "validation": {},
  "events": [
    "onChange"
  ],
  "actions": {
    "clear": [],
    "setDisable": [
      "value"
    ],
    "setLoading": [
      "value"
    ],
    "setSelected": [
      "selected"
    ],
    "setVisibility": [
      "value"
    ]
  },
  "exposed": [
    "isDisabled",
    "isLoading",
    "isVisible",
    "value"
  ]
}
