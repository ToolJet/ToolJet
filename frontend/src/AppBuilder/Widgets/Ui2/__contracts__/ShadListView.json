{
  "type": "ShadListView",
  "properties": {
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "columns": {
      "type": "number",
      "default": 3,
      "initial": "{{3}}"
    },
    "data": {
      "type": "array",
      "default": [],
      "initial": "{{[{ id: 1, name: 'Ada Lovelace', email: 'ada@example.com', role: 'Engineering' }, { id: 2, name: 'Alan Turing', email: 'alan@example.com', role: 'Research' }, { id: 3, name: 'Grace Hopper', email: 'grace@example.com', role: 'Platform' }]}}"
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "dynamicHeight": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "emptyText": {
      "type": "string",
      "default": "No items",
      "initial": "No items"
    },
    "enablePagination": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "gap": {
      "type": "number",
      "default": 8,
      "initial": "{{8}}"
    },
    "highlightSelectedRow": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "idField": {
      "type": "string",
      "default": "id",
      "initial": "id"
    },
    "loadingIndicator": {
      "type": "string",
      "default": "spinner",
      "initial": "spinner"
    },
    "loadingState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "mode": {
      "type": "string",
      "default": "list",
      "initial": "list"
    },
    "rowHeight": {
      "type": "number",
      "default": 72,
      "initial": "{{72}}"
    },
    "rowsPerPage": {
      "type": "number",
      "default": 10,
      "initial": "{{10}}"
    },
    "serverSidePagination": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "showBorder": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "totalRecords": {
      "type": "number",
      "default": 0,
      "initial": "{{0}}"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    }
  },
  "styles": {
    "accentColor": {
      "type": "string"
    },
    "backgroundColor": {
      "type": "string"
    },
    "boxShadow": {
      "type": "union<string|number>",
      "default": "0px 0px 0px 0px #00000040",
      "initial": "0px 0px 0px 0px #00000040"
    },
    "dividerColor": {
      "type": "string"
    },
    "emptyTextColor": {
      "type": "string"
    },
    "itemBackgroundColor": {
      "type": "string"
    },
    "itemBorderColor": {
      "type": "string"
    },
    "itemBorderRadius": {
      "type": "union<string|number>"
    },
    "itemHoverBackgroundColor": {
      "type": "string"
    },
    "itemShadow": {
      "type": "string",
      "default": "none",
      "initial": "none"
    },
    "itemVariant": {
      "type": "string",
      "default": "plain",
      "initial": "outline"
    },
    "padding": {
      "type": "union<string|number>"
    },
    "selectedItemBackgroundColor": {
      "type": "string"
    }
  },
  "validation": {},
  "events": [
    "onPageChanged",
    "onRecordClicked"
  ],
  "actions": {
    "clearSelection": [],
    "selectItem": [
      "id"
    ],
    "setDisable": [
      "value"
    ],
    "setLoading": [
      "value"
    ],
    "setPage": [
      "page"
    ],
    "setVisibility": [
      "value"
    ]
  },
  "exposed": [
    "children",
    "data",
    "isDisabled",
    "isLoading",
    "isVisible",
    "pageIndex",
    "selectedItem",
    "selectedItemId",
    "selectedRecord",
    "selectedRecordId"
  ]
}
