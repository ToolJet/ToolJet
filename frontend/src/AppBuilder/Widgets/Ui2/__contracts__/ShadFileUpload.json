{
  "type": "ShadFileUpload",
  "properties": {
    "accept": {
      "type": "string",
      "default": "",
      "initial": "image/*,application/pdf"
    },
    "collapseWhenHidden": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "delimiter": {
      "type": "string",
      "default": ",",
      "initial": ","
    },
    "description": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "disabledState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "dynamicHeight": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "hint": {
      "type": "string",
      "default": "",
      "initial": ""
    },
    "label": {
      "type": "string",
      "default": "",
      "initial": "Attachments"
    },
    "loadingState": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "maxFiles": {
      "type": "union<string|number>",
      "default": 5,
      "initial": "{{5}}"
    },
    "maxSize": {
      "type": "union<string|number>",
      "default": 5242880,
      "initial": "{{5242880}}"
    },
    "minSize": {
      "type": "union<string|number>",
      "default": 0,
      "initial": "{{0}}"
    },
    "multiple": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "parseContent": {
      "type": "boolean",
      "default": false,
      "initial": "{{false}}"
    },
    "parseFileType": {
      "type": "string",
      "default": "auto-detect",
      "initial": "auto-detect"
    },
    "showPreview": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    },
    "title": {
      "type": "string",
      "default": "Drag & drop files here",
      "initial": "Drag & drop files here"
    },
    "tooltip": {
      "type": "string",
      "initial": ""
    },
    "tooltipFormat": {
      "type": "any",
      "default": "plainText",
      "initial": "plainText"
    },
    "visibility": {
      "type": "boolean",
      "default": true,
      "initial": "{{true}}"
    }
  },
  "styles": {
    "accentColor": {
      "type": "string"
    },
    "borderRadius": {
      "type": "union<string|number>"
    },
    "boxShadow": {
      "type": "union<string|number>",
      "default": "0px 0px 0px 0px #00000040",
      "initial": "0px 0px 0px 0px #00000040"
    },
    "dropzoneBackgroundColor": {
      "type": "string"
    },
    "dropzoneBorderColor": {
      "type": "string"
    },
    "errorColor": {
      "type": "string"
    },
    "fileItemBackgroundColor": {
      "type": "string"
    },
    "fileItemBorderColor": {
      "type": "string"
    },
    "helpTextColor": {
      "type": "string"
    },
    "hintColor": {
      "type": "string"
    },
    "iconBackgroundColor": {
      "type": "string"
    },
    "iconColor": {
      "type": "string"
    },
    "labelColor": {
      "type": "string"
    },
    "titleColor": {
      "type": "string"
    }
  },
  "validation": {
    "customRule": {
      "initial": ""
    },
    "mandatory": {
      "initial": "{{false}}"
    }
  },
  "events": [
    "onFileDeselected",
    "onFileLoaded",
    "onFileSelected"
  ],
  "actions": {
    "clearFiles": [],
    "setDisable": [
      "value"
    ],
    "setFileName": [
      "indexOrUpdates",
      "newNameIfSingle"
    ],
    "setLoading": [
      "value"
    ],
    "setVisibility": [
      "value"
    ]
  },
  "exposed": [
    "file",
    "fileSize",
    "isDisabled",
    "isLoading",
    "isMandatory",
    "isParsing",
    "isValid",
    "isVisible",
    "label"
  ]
}
