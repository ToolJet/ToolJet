      "options": {
        "code": "// Calls radioGroup1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.radioGroup1.selectOption(\"Premium\");\nawait components.radioGroup1.deselectOption();\nawait components.radioGroup1.setLoading(true);\nawait components.radioGroup1.setLoading(false);\nawait components.radioGroup1.setDisable(true);\nawait components.radioGroup1.setDisable(false);\nawait components.radioGroup1.setVisibility(false);\nawait components.radioGroup1.setVisibility(true);\nreturn { \"isVisible\": components.radioGroup1.isVisible, \"isLoading\": components.radioGroup1.isLoading, \"isDisabled\": components.radioGroup1.isDisabled, \"isValid\": components.radioGroup1.isValid, \"isMandatory\": components.radioGroup1.isMandatory, \"value\": components.radioGroup1.value, \"label\": components.radioGroup1.label, \"selectedOption\": components.radioGroup1.selectedOption, \"options\": components.radioGroup1.options };",
