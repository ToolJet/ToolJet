      "options": {
        "code": "// Calls text1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.text1.setText(\"Saved text\");\nawait components.text1.clear();\nawait components.text1.setLoading(true);\nawait components.text1.setLoading(false);\nawait components.text1.setDisable(true);\nawait components.text1.setDisable(false);\nawait components.text1.setVisibility(false);\nawait components.text1.setVisibility(true);\nreturn { \"isVisible\": components.text1.isVisible, \"isLoading\": components.text1.isLoading, \"isDisabled\": components.text1.isDisabled, \"text\": components.text1.text };",
