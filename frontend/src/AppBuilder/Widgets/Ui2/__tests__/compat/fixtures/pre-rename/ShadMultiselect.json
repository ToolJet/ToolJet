      "id": "d7175942-9cdf-508f-ae32-d68978689c1d",
      "name": "callWidget",
      "kind": "runjs",
      "appVersionId": "ad846c24-b5ba-52a5-aea5-414fb9dd839c",
      "options": {
        "code": "// Calls multiselect1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.multiselect1.selectOptions(['sales']);\nawait components.multiselect1.deselectOptions(['design']);\nawait components.multiselect1.clear();\nawait components.multiselect1.setFocus();\nawait components.multiselect1.setBlur();\nawait components.multiselect1.setLoading(true);\nawait components.multiselect1.setLoading(false);\nawait components.multiselect1.setDisable(true);\nawait components.multiselect1.setDisable(false);\nawait components.multiselect1.setVisibility(false);\nawait components.multiselect1.setVisibility(true);\nreturn { \"isVisible\": components.multiselect1.isVisible, \"isLoading\": components.multiselect1.isLoading, \"isDisabled\": components.multiselect1.isDisabled, \"isValid\": components.multiselect1.isValid, \"isMandatory\": components.multiselect1.isMandatory, \"values\": components.multiselect1.values, \"selectedOptions\": components.multiselect1.selectedOptions, \"searchText\": components.multiselect1.searchText, \"options\": components.multiselect1.options, \"label\": components.multiselect1.label };",
