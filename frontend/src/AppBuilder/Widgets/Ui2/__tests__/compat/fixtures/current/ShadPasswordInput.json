      "options": {
        "code": "// Calls passwordInput1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.passwordInput1.setText(\"s3cret-saved\");\nawait components.passwordInput1.clear();\nawait components.passwordInput1.setFocus();\nawait components.passwordInput1.setBlur();\nawait components.passwordInput1.setLoading(true);\nawait components.passwordInput1.setLoading(false);\nawait components.passwordInput1.setDisable(true);\nawait components.passwordInput1.setDisable(false);\nawait components.passwordInput1.setVisibility(false);\nawait components.passwordInput1.setVisibility(true);\nreturn { \"isVisible\": components.passwordInput1.isVisible, \"isLoading\": components.passwordInput1.isLoading, \"isDisabled\": components.passwordInput1.isDisabled, \"isValid\": components.passwordInput1.isValid, \"isMandatory\": components.passwordInput1.isMandatory, \"value\": components.passwordInput1.value, \"strength\": components.passwordInput1.strength, \"label\": components.passwordInput1.label };",
