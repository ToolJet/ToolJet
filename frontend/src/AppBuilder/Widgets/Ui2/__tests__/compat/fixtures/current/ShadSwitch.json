      "options": {
        "code": "// Calls switch1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.switch1.toggle();\nawait components.switch1.setValue(true);\nawait components.switch1.setLoading(true);\nawait components.switch1.setLoading(false);\nawait components.switch1.setDisable(true);\nawait components.switch1.setDisable(false);\nawait components.switch1.setVisibility(false);\nawait components.switch1.setVisibility(true);\nreturn { \"isVisible\": components.switch1.isVisible, \"isLoading\": components.switch1.isLoading, \"isDisabled\": components.switch1.isDisabled, \"value\": components.switch1.value, \"label\": components.switch1.label };",
