      "options": {
        "code": "// Calls buttonGroup1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.buttonGroup1.setSelected(\"month\");\nawait components.buttonGroup1.clear();\nawait components.buttonGroup1.setLoading(true);\nawait components.buttonGroup1.setLoading(false);\nawait components.buttonGroup1.setDisable(true);\nawait components.buttonGroup1.setDisable(false);\nawait components.buttonGroup1.setVisibility(false);\nawait components.buttonGroup1.setVisibility(true);\nreturn { \"isVisible\": components.buttonGroup1.isVisible, \"isLoading\": components.buttonGroup1.isLoading, \"isDisabled\": components.buttonGroup1.isDisabled, \"value\": components.buttonGroup1.value, \"selected\": components.buttonGroup1.selected, \"lastClicked\": components.buttonGroup1.lastClicked, \"isValid\": components.buttonGroup1.isValid, \"isMandatory\": components.buttonGroup1.isMandatory };",
