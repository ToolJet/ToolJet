      "appVersionId": "03cce546-8a26-566c-a754-1831b4e12a39",
      "options": {
        "code": "// Calls navigation1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.navigation1.selectItem(\"orders\");\nawait components.navigation1.setItemVisibility(\"reports\", false);\nawait components.navigation1.setItemDisable(\"customers\", true);\nawait components.navigation1.setCollapsed(true);\nawait components.navigation1.setLoading(true);\nawait components.navigation1.setLoading(false);\nawait components.navigation1.setDisable(true);\nawait components.navigation1.setDisable(false);\nawait components.navigation1.setVisibility(false);\nawait components.navigation1.setVisibility(true);\nreturn { \"isVisible\": components.navigation1.isVisible, \"isLoading\": components.navigation1.isLoading, \"isDisabled\": components.navigation1.isDisabled, \"value\": components.navigation1.value, \"selectedItem\": components.navigation1.selectedItem, \"previousSelectedItem\": components.navigation1.previousSelectedItem, \"isCollapsed\": components.navigation1.isCollapsed };",
