      "options": {
        "code": "// Calls tagsInput1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.tagsInput1.setTags(['saved', 'tags']);\nawait components.tagsInput1.selectTags(['node']);\nawait components.tagsInput1.deselectTags(['react']);\nawait components.tagsInput1.clear();\nawait components.tagsInput1.setFocus();\nawait components.tagsInput1.setBlur();\nawait components.tagsInput1.setLoading(true);\nawait components.tagsInput1.setLoading(false);\nawait components.tagsInput1.setDisable(true);\nawait components.tagsInput1.setDisable(false);\nawait components.tagsInput1.setVisibility(false);\nawait components.tagsInput1.setVisibility(true);\nreturn { \"isVisible\": components.tagsInput1.isVisible, \"isLoading\": components.tagsInput1.isLoading, \"isDisabled\": components.tagsInput1.isDisabled, \"isValid\": components.tagsInput1.isValid, \"isMandatory\": components.tagsInput1.isMandatory, \"tags\": components.tagsInput1.tags, \"value\": components.tagsInput1.value, \"values\": components.tagsInput1.values, \"selectedTags\": components.tagsInput1.selectedTags, \"newTagsAdded\": components.tagsInput1.newTagsAdded, \"lastAddedTag\": components.tagsInput1.lastAddedTag, \"lastRemovedTag\": components.tagsInput1.lastRemovedTag, \"label\": components.tagsInput1.label };",
