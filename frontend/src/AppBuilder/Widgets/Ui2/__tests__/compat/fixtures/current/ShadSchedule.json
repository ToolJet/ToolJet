        "code": "// Calls schedule1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.schedule1.setLoading(true);\nawait components.schedule1.setLoading(false);\nawait components.schedule1.setDisable(true);\nawait components.schedule1.setDisable(false);\nawait components.schedule1.setVisibility(false);\nawait components.schedule1.setVisibility(true);\nreturn { \"isVisible\": components.schedule1.isVisible, \"isLoading\": components.schedule1.isLoading, \"isDisabled\": components.schedule1.isDisabled, \"selectedBooking\": components.schedule1.selectedBooking, \"selectedBookingId\": components.schedule1.selectedBookingId, \"selectedSlot\": components.schedule1.selectedSlot };",
