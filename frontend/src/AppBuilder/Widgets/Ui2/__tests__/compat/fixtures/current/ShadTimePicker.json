      "id": "943bb0cb-3f38-5b52-aa6d-408e786f63dd",
      "name": "callWidget",
      "kind": "runjs",
      "appVersionId": "0c43920d-51d9-54aa-a5c9-45bd47b17b20",
      "options": {
        "code": "// Calls timePicker1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.timePicker1.setValue(\"09:15\", \"HH:mm\");\nawait components.timePicker1.clearValue();\nawait components.timePicker1.setMinTime(\"08:00\");\nawait components.timePicker1.setMaxTime(\"18:00\");\nawait components.timePicker1.setFocus();\nawait components.timePicker1.setBlur();\nawait components.timePicker1.setLoading(true);\nawait components.timePicker1.setLoading(false);\nawait components.timePicker1.setDisable(true);\nawait components.timePicker1.setDisable(false);\nawait components.timePicker1.setVisibility(false);\nawait components.timePicker1.setVisibility(true);\nreturn { \"isVisible\": components.timePicker1.isVisible, \"isLoading\": components.timePicker1.isLoading, \"isDisabled\": components.timePicker1.isDisabled, \"isValid\": components.timePicker1.isValid, \"isMandatory\": components.timePicker1.isMandatory, \"value\": components.timePicker1.value, \"formattedValue\": components.timePicker1.formattedValue, \"label\": components.timePicker1.label, \"timeFormat\": components.timePicker1.timeFormat, \"minTime\": components.timePicker1.minTime, \"maxTime\": components.timePicker1.maxTime };",
