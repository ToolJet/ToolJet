      "options": {
        "code": "// Calls image1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.image1.setImageURL(\"https://picsum.photos/seed/tj-saved/640/360\");\nawait components.image1.clearImage();\nawait components.image1.setLoading(true);\nawait components.image1.setLoading(false);\nawait components.image1.setDisable(true);\nawait components.image1.setDisable(false);\nawait components.image1.setVisibility(false);\nawait components.image1.setVisibility(true);\nreturn { \"isVisible\": components.image1.isVisible, \"isLoading\": components.image1.isLoading, \"isDisabled\": components.image1.isDisabled, \"hasError\": components.image1.hasError, \"imageURL\": components.image1.imageURL, \"alternativeText\": components.image1.alternativeText };",
