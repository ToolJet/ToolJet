      "kind": "runjs",
      "appVersionId": "4b2ce6da-10e6-56f0-a246-4f6405abaa41",
      "options": {
        "code": "// Calls steps1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.steps1.setStep(1);\nawait components.steps1.nextStep();\nawait components.steps1.previousStep();\nawait components.steps1.resetSteps();\nawait components.steps1.setStepVisible(4, false);\nawait components.steps1.setStepDisable(3, true);\nawait components.steps1.setDisabled(true);\nawait components.steps1.setLoading(true);\nawait components.steps1.setLoading(false);\nawait components.steps1.setDisable(true);\nawait components.steps1.setDisable(false);\nawait components.steps1.setVisibility(false);\nawait components.steps1.setVisibility(true);\nreturn { \"isVisible\": components.steps1.isVisible, \"isLoading\": components.steps1.isLoading, \"isDisabled\": components.steps1.isDisabled, \"currentStepId\": components.steps1.currentStepId, \"currentStepIndex\": components.steps1.currentStepIndex, \"steps\": components.steps1.steps };",
