      "options": {
        "code": "// Calls combobox1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.combobox1.selectOption(\"ca\");\nawait components.combobox1.clear();\nawait components.combobox1.setFocus();\nawait components.combobox1.setBlur();\nawait components.combobox1.setLoading(true);\nawait components.combobox1.setLoading(false);\nawait components.combobox1.setDisable(true);\nawait components.combobox1.setDisable(false);\nawait components.combobox1.setVisibility(false);\nawait components.combobox1.setVisibility(true);\nreturn { \"isVisible\": components.combobox1.isVisible, \"isLoading\": components.combobox1.isLoading, \"isDisabled\": components.combobox1.isDisabled, \"isValid\": components.combobox1.isValid, \"isMandatory\": components.combobox1.isMandatory, \"value\": components.combobox1.value, \"selectedOption\": components.combobox1.selectedOption, \"searchText\": components.combobox1.searchText, \"options\": components.combobox1.options, \"label\": components.combobox1.label };",
