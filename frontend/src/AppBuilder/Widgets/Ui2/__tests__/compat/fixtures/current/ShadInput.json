      "options": {
        "code": "// Calls input1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.input1.setText(\"Saved text\");\nawait components.input1.clear();\nawait components.input1.setFocus();\nawait components.input1.setBlur();\nawait components.input1.setLoading(true);\nawait components.input1.setLoading(false);\nawait components.input1.setDisable(true);\nawait components.input1.setDisable(false);\nawait components.input1.setVisibility(false);\nawait components.input1.setVisibility(true);\nreturn { \"isVisible\": components.input1.isVisible, \"isLoading\": components.input1.isLoading, \"isDisabled\": components.input1.isDisabled, \"isValid\": components.input1.isValid, \"isMandatory\": components.input1.isMandatory, \"value\": components.input1.value, \"label\": components.input1.label };",
