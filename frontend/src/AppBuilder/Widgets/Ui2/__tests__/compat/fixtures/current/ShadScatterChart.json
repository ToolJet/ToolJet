      "options": {
        "code": "// Calls scatterChart1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.scatterChart1.clearClickedPoint();\nawait components.scatterChart1.setLoading(true);\nawait components.scatterChart1.setLoading(false);\nawait components.scatterChart1.setDisable(true);\nawait components.scatterChart1.setDisable(false);\nawait components.scatterChart1.setVisibility(false);\nawait components.scatterChart1.setVisibility(true);\nreturn { \"isVisible\": components.scatterChart1.isVisible, \"isLoading\": components.scatterChart1.isLoading, \"isDisabled\": components.scatterChart1.isDisabled, \"clickedDataPoint\": components.scatterChart1.clickedDataPoint };",
