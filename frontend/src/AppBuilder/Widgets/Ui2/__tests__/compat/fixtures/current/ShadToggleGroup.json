      "options": {
        "code": "// Calls toggleGroup1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.toggleGroup1.setSelected(\"Open\");\nawait components.toggleGroup1.clear();\nawait components.toggleGroup1.setLoading(true);\nawait components.toggleGroup1.setLoading(false);\nawait components.toggleGroup1.setDisable(true);\nawait components.toggleGroup1.setDisable(false);\nawait components.toggleGroup1.setVisibility(false);\nawait components.toggleGroup1.setVisibility(true);\nreturn { \"isVisible\": components.toggleGroup1.isVisible, \"isLoading\": components.toggleGroup1.isLoading, \"isDisabled\": components.toggleGroup1.isDisabled, \"value\": components.toggleGroup1.value };",
