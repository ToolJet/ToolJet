      "options": {
        "code": "// Calls otpInput1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.otpInput1.clear();\nawait components.otpInput1.setFocus();\nawait components.otpInput1.setBlur();\nawait components.otpInput1.setText(\"1234\");\nawait components.otpInput1.setLoading(true);\nawait components.otpInput1.setLoading(false);\nawait components.otpInput1.setDisable(true);\nawait components.otpInput1.setDisable(false);\nawait components.otpInput1.setVisibility(false);\nawait components.otpInput1.setVisibility(true);\nreturn { \"isVisible\": components.otpInput1.isVisible, \"isLoading\": components.otpInput1.isLoading, \"isDisabled\": components.otpInput1.isDisabled, \"isValid\": components.otpInput1.isValid, \"isMandatory\": components.otpInput1.isMandatory, \"value\": components.otpInput1.value, \"isComplete\": components.otpInput1.isComplete, \"label\": components.otpInput1.label };",
