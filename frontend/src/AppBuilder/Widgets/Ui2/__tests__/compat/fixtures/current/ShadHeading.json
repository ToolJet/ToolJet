      "options": {
        "code": "// Calls heading1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.heading1.setText(\"Saved heading\");\nawait components.heading1.clear();\nawait components.heading1.setLoading(true);\nawait components.heading1.setLoading(false);\nawait components.heading1.setDisable(true);\nawait components.heading1.setDisable(false);\nawait components.heading1.setVisibility(false);\nawait components.heading1.setVisibility(true);\nreturn { \"isVisible\": components.heading1.isVisible, \"isLoading\": components.heading1.isLoading, \"isDisabled\": components.heading1.isDisabled, \"text\": components.heading1.text };",
