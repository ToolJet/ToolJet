      "appVersionId": "fe043196-c462-5d9d-afa7-aab9fb6cffed",
      "options": {
        "code": "// Calls tabs1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.tabs1.setTab(\"t1\");\nawait components.tabs1.nextTab();\nawait components.tabs1.previousTab();\nawait components.tabs1.setTabDisable(\"t2\", true);\nawait components.tabs1.setTabLoading(\"t2\", false);\nawait components.tabs1.setTabVisibility(\"t2\", true);\nawait components.tabs1.setLoading(true);\nawait components.tabs1.setLoading(false);\nawait components.tabs1.setDisable(true);\nawait components.tabs1.setDisable(false);\nawait components.tabs1.setVisibility(false);\nawait components.tabs1.setVisibility(true);\nreturn { \"isVisible\": components.tabs1.isVisible, \"isLoading\": components.tabs1.isLoading, \"isDisabled\": components.tabs1.isDisabled, \"currentTab\": components.tabs1.currentTab, \"currentTabTitle\": components.tabs1.currentTabTitle, \"currentStepIndex\": components.tabs1.currentStepIndex, \"isFirstStep\": components.tabs1.isFirstStep, \"isLastStep\": components.tabs1.isLastStep };",
