      "kind": "runjs",
      "appVersionId": "4463e693-59a4-5f86-a3f3-9f09c310e376",
      "options": {
        "code": "// Calls kanban1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.kanban1.addCard({ id: 9, title: 'Saved card', status: 'todo' }, \"todo\");\nawait components.kanban1.moveCard(1, \"done\");\nawait components.kanban1.deleteCard(3);\nawait components.kanban1.updateCardData(2, { title: 'Renamed card' });\nawait components.kanban1.setLoading(true);\nawait components.kanban1.setLoading(false);\nawait components.kanban1.setDisable(true);\nawait components.kanban1.setDisable(false);\nawait components.kanban1.setVisibility(false);\nawait components.kanban1.setVisibility(true);\nreturn { \"isVisible\": components.kanban1.isVisible, \"isLoading\": components.kanban1.isLoading, \"isDisabled\": components.kanban1.isDisabled, \"updatedCardData\": components.kanban1.updatedCardData, \"lastSelectedCard\": components.kanban1.lastSelectedCard, \"lastCardMovement\": components.kanban1.lastCardMovement, \"addCardColumn\": components.kanban1.addCardColumn, \"collapsedColumns\": components.kanban1.collapsedColumns, \"lastAddedCard\": components.kanban1.lastAddedCard, \"lastUpdatedCard\": components.kanban1.lastUpdatedCard, \"lastRemovedCard\": components.kanban1.lastRemovedCard };",
