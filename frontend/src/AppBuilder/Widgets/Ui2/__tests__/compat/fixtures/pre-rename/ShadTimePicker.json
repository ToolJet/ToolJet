      "id": "7ee197d0-9d6f-5a5a-a0de-19cb2b11b825",
      "name": "callWidget",
      "kind": "runjs",
      "appVersionId": "c96200bf-23d3-50f6-a45f-ccfac7919f2a",
      "options": {
        "code": "// Calls timePicker1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.timePicker1.setTime(\"09:15\");\nawait components.timePicker1.setValue(\"09:15\", \"HH:mm\");\nawait components.timePicker1.clear();\nawait components.timePicker1.clearValue();\nawait components.timePicker1.setMinTime(\"08:00\");\nawait components.timePicker1.setMaxTime(\"18:00\");\nawait components.timePicker1.setFocus();\nawait components.timePicker1.setBlur();\nawait components.timePicker1.setLoading(true);\nawait components.timePicker1.setLoading(false);\nawait components.timePicker1.setDisable(true);\nawait components.timePicker1.setDisable(false);\nawait components.timePicker1.setVisibility(false);\nawait components.timePicker1.setVisibility(true);\nreturn { \"isVisible\": components.timePicker1.isVisible, \"isLoading\": components.timePicker1.isLoading, \"isDisabled\": components.timePicker1.isDisabled, \"isValid\": components.timePicker1.isValid, \"isMandatory\": components.timePicker1.isMandatory, \"value\": components.timePicker1.value, \"formattedValue\": components.timePicker1.formattedValue, \"label\": components.timePicker1.label, \"timeFormat\": components.timePicker1.timeFormat, \"minTime\": components.timePicker1.minTime, \"maxTime\": components.timePicker1.maxTime };",
