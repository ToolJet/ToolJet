      "options": {
        "code": "// Calls table1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.table1.setPage(1);\nawait components.table1.selectRow(\"id\", 2);\nawait components.table1.deselectRow();\nawait components.table1.selectRows(\"id\", [1, 3]);\nawait components.table1.deselectRows(\"id\", [3]);\nawait components.table1.selectAllRows();\nawait components.table1.deselectAllRows();\nawait components.table1.setFilters([{ column: 'status', condition: 'equals', value: 'Paid' }]);\nawait components.table1.clearFilters();\nawait components.table1.setSort(\"amount\", \"desc\");\nawait components.table1.setSearchText(\"Ada\");\nawait components.table1.discardChanges();\nawait components.table1.setLoading(true);\nawait components.table1.setLoading(false);\nawait components.table1.setDisable(true);\nawait components.table1.setDisable(false);\nawait components.table1.setVisibility(false);\nawait components.table1.setVisibility(true);\nreturn { \"isVisible\": components.table1.isVisible, \"isLoading\": components.table1.isLoading, \"isDisabled\": components.table1.isDisabled, \"selectedRow\": components.table1.selectedRow, \"selectedRowId\": components.table1.selectedRowId, \"selectedRows\": components.table1.selectedRows, \"selectedRowsId\": components.table1.selectedRowsId, \"pageIndex\": components.table1.pageIndex, \"searchText\": components.table1.searchText, \"sortApplied\": components.table1.sortApplied, \"filters\": components.table1.filters, \"changeSet\": components.table1.changeSet, \"dataUpdates\": components.table1.dataUpdates, \"updatedData\": components.table1.updatedData, \"currentData\": components.table1.currentData, \"currentPageData\": components.table1.currentPageData, \"filteredData\": components.table1.filteredData, \"lastActionClicked\": components.table1.lastActionClicked, \"hoveredRow\": components.table1.hoveredRow, \"hoveredRowId\": components.table1.hoveredRowId, \"selectedColumnHeader\": components.table1.selectedColumnHeader };",
