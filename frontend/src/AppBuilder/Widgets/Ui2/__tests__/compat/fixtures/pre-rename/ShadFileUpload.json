      "options": {
        "code": "// Calls fileUpload1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.fileUpload1.clearFiles();\nawait components.fileUpload1.clear();\nawait components.fileUpload1.setFileName(0, \"saved.csv\");\nawait components.fileUpload1.setLoading(true);\nawait components.fileUpload1.setLoading(false);\nawait components.fileUpload1.setDisable(true);\nawait components.fileUpload1.setDisable(false);\nawait components.fileUpload1.setVisibility(false);\nawait components.fileUpload1.setVisibility(true);\nreturn { \"isVisible\": components.fileUpload1.isVisible, \"isLoading\": components.fileUpload1.isLoading, \"isDisabled\": components.fileUpload1.isDisabled, \"isValid\": components.fileUpload1.isValid, \"isMandatory\": components.fileUpload1.isMandatory, \"files\": components.fileUpload1.files, \"file\": components.fileUpload1.file, \"fileSize\": components.fileUpload1.fileSize, \"isParsing\": components.fileUpload1.isParsing, \"label\": components.fileUpload1.label };",
