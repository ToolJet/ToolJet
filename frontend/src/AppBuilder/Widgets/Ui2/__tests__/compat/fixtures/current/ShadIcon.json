      "options": {
        "code": "// Calls icon1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.icon1.click();\nawait components.icon1.setLoading(true);\nawait components.icon1.setLoading(false);\nawait components.icon1.setDisable(true);\nawait components.icon1.setDisable(false);\nawait components.icon1.setVisibility(false);\nawait components.icon1.setVisibility(true);\nreturn { \"isVisible\": components.icon1.isVisible, \"isLoading\": components.icon1.isLoading, \"isDisabled\": components.icon1.isDisabled };",
