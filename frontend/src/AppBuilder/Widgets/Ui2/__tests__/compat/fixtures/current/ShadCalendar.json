        "code": "// Calls calendar1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.calendar1.selectDate(\"2026-06-18\", \"\");\nawait components.calendar1.clear();\nawait components.calendar1.setMonth(\"2026-07-01\");\nawait components.calendar1.setLoading(true);\nawait components.calendar1.setLoading(false);\nawait components.calendar1.setDisable(true);\nawait components.calendar1.setDisable(false);\nawait components.calendar1.setVisibility(false);\nawait components.calendar1.setVisibility(true);\nreturn { \"isVisible\": components.calendar1.isVisible, \"isLoading\": components.calendar1.isLoading, \"isDisabled\": components.calendar1.isDisabled, \"value\": components.calendar1.value, \"selectedDate\": components.calendar1.selectedDate, \"selectedDates\": components.calendar1.selectedDates, \"startDate\": components.calendar1.startDate, \"endDate\": components.calendar1.endDate, \"visibleMonth\": components.calendar1.visibleMonth, \"visibleStart\": components.calendar1.visibleStart, \"visibleEnd\": components.calendar1.visibleEnd };",
