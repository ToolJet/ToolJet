        "code": "// Calls progressList1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.progressList1.setLoading(true);\nawait components.progressList1.setLoading(false);\nawait components.progressList1.setDisable(true);\nawait components.progressList1.setDisable(false);\nawait components.progressList1.setVisibility(false);\nawait components.progressList1.setVisibility(true);\nreturn { \"isVisible\": components.progressList1.isVisible, \"isLoading\": components.progressList1.isLoading, \"isDisabled\": components.progressList1.isDisabled, \"selectedItem\": components.progressList1.selectedItem, \"selectedItemId\": components.progressList1.selectedItemId };",
