        "code": "// Calls sparkline1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.sparkline1.setLoading(true);\nawait components.sparkline1.setLoading(false);\nawait components.sparkline1.setDisable(true);\nawait components.sparkline1.setDisable(false);\nawait components.sparkline1.setVisibility(false);\nawait components.sparkline1.setVisibility(true);\nreturn { \"isVisible\": components.sparkline1.isVisible, \"isLoading\": components.sparkline1.isLoading, \"isDisabled\": components.sparkline1.isDisabled, \"trend\": components.sparkline1.trend, \"lastValue\": components.sparkline1.lastValue };",
