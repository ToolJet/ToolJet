      "options": {
        "code": "// Calls link1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.link1.click();\nawait components.link1.setLinkTarget(\"https://example.com/saved\");\nawait components.link1.setLinkText(\"Saved link\");\nawait components.link1.setLoading(true);\nawait components.link1.setLoading(false);\nawait components.link1.setDisable(true);\nawait components.link1.setDisable(false);\nawait components.link1.setVisibility(false);\nawait components.link1.setVisibility(true);\nreturn { \"isVisible\": components.link1.isVisible, \"isLoading\": components.link1.isLoading, \"isDisabled\": components.link1.isDisabled, \"linkTarget\": components.link1.linkTarget, \"linkText\": components.link1.linkText };",
