      "options": {
        "code": "// Calls accordion1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.accordion1.expand(1);\nawait components.accordion1.collapse(1);\nawait components.accordion1.setLoading(true);\nawait components.accordion1.setLoading(false);\nawait components.accordion1.setDisable(true);\nawait components.accordion1.setDisable(false);\nawait components.accordion1.setVisibility(false);\nawait components.accordion1.setVisibility(true);\nreturn { \"isVisible\": components.accordion1.isVisible, \"isLoading\": components.accordion1.isLoading, \"isDisabled\": components.accordion1.isDisabled, \"openIndexes\": components.accordion1.openIndexes, \"isExpanded\": components.accordion1.isExpanded };",
