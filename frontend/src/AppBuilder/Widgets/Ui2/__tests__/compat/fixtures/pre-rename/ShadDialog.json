      "options": {
        "code": "// Calls dialog1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.dialog1.open();\nawait components.dialog1.close();\nawait components.dialog1.setDisableTrigger(false);\nawait components.dialog1.setDisableModal(false);\nawait components.dialog1.setLoading(true);\nawait components.dialog1.setLoading(false);\nawait components.dialog1.setVisibility(false);\nawait components.dialog1.setVisibility(true);\nreturn { \"show\": components.dialog1.show, \"isDisabledModal\": components.dialog1.isDisabledModal, \"isDisabledTrigger\": components.dialog1.isDisabledTrigger, \"isVisible\": components.dialog1.isVisible, \"isLoading\": components.dialog1.isLoading };",
