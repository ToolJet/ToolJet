  "dataQueries": [
    {
      "id": "1faa7468-3229-5ec9-a3f8-1bdec5b820f0",
      "name": "callWidget",
      "kind": "runjs",
      "appVersionId": "086f8f2e-b16e-535d-a729-412f262e0f70",
      "options": {
        "code": "// Calls chat1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.chat1.appendHistory({ message: 'Saved message', type: 'response' });\nawait components.chat1.clearHistory();\nawait components.chat1.sendMessage({ message: 'Hello from a saved app' });\nawait components.chat1.setError(\"Saved error\");\nawait components.chat1.setHistory([{ message: 'Earlier message', type: 'message' }]);\nawait components.chat1.setHistoryLoading(false);\nawait components.chat1.setInputDisable(false);\nawait components.chat1.setResponderAvatar(\"https://picsum.photos/seed/tj-bot/64/64\");\nawait components.chat1.setResponseLoading(false);\nawait components.chat1.setUserAvatar(\"https://picsum.photos/seed/tj-user/64/64\");\nawait components.chat1.setLoading(true);\nawait components.chat1.setLoading(false);\nawait components.chat1.setDisable(true);\nawait components.chat1.setDisable(false);\nawait components.chat1.setVisibility(false);\nawait components.chat1.setVisibility(true);\nreturn { \"isVisible\": components.chat1.isVisible, \"isLoading\": components.chat1.isLoading, \"isDisabled\": components.chat1.isDisabled, \"history\": components.chat1.history, \"isHistoryLoading\": components.chat1.isHistoryLoading, \"isInputDisabled\": components.chat1.isInputDisabled, \"isResponseLoading\": components.chat1.isResponseLoading, \"lastMessage\": components.chat1.lastMessage, \"lastResponse\": components.chat1.lastResponse };",
        "hasParamSupport": false,
        "parameters": []
      }
    }
  ]
