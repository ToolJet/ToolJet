      "options": {
        "code": "// Calls questionnaire1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.questionnaire1.reset();\nawait components.questionnaire1.goTo(1);\nawait components.questionnaire1.setLoading(true);\nawait components.questionnaire1.setLoading(false);\nawait components.questionnaire1.setDisable(true);\nawait components.questionnaire1.setDisable(false);\nawait components.questionnaire1.setVisibility(false);\nawait components.questionnaire1.setVisibility(true);\nreturn { \"isVisible\": components.questionnaire1.isVisible, \"isLoading\": components.questionnaire1.isLoading, \"isDisabled\": components.questionnaire1.isDisabled, \"answers\": components.questionnaire1.answers, \"currentIndex\": components.questionnaire1.currentIndex, \"currentItem\": components.questionnaire1.currentItem, \"isComplete\": components.questionnaire1.isComplete };",
