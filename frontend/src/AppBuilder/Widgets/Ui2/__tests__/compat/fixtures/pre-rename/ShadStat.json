      "options": {
        "code": "// Calls stat1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.stat1.setPrimaryValue(\"$12,400\");\nawait components.stat1.setSecondaryValue(\"+8% on last month\");\nawait components.stat1.setLoading(true);\nawait components.stat1.setLoading(false);\nawait components.stat1.setDisable(true);\nawait components.stat1.setDisable(false);\nawait components.stat1.setVisibility(false);\nawait components.stat1.setVisibility(true);\nreturn { \"isVisible\": components.stat1.isVisible, \"isLoading\": components.stat1.isLoading, \"isDisabled\": components.stat1.isDisabled, \"primaryLabel\": components.stat1.primaryLabel, \"primaryValue\": components.stat1.primaryValue, \"secondaryLabel\": components.stat1.secondaryLabel, \"secondaryValue\": components.stat1.secondaryValue };",
