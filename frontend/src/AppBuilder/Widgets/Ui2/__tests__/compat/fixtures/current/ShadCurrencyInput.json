      "options": {
        "code": "// Calls currencyInput1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.currencyInput1.setValue(1234.5, \"EUR\");\nawait components.currencyInput1.setCurrency(\"USD\");\nawait components.currencyInput1.clear();\nawait components.currencyInput1.setFocus();\nawait components.currencyInput1.setBlur();\nawait components.currencyInput1.setLoading(true);\nawait components.currencyInput1.setLoading(false);\nawait components.currencyInput1.setDisable(true);\nawait components.currencyInput1.setDisable(false);\nawait components.currencyInput1.setVisibility(false);\nawait components.currencyInput1.setVisibility(true);\nreturn { \"isVisible\": components.currencyInput1.isVisible, \"isLoading\": components.currencyInput1.isLoading, \"isDisabled\": components.currencyInput1.isDisabled, \"isValid\": components.currencyInput1.isValid, \"isMandatory\": components.currencyInput1.isMandatory, \"value\": components.currencyInput1.value, \"formattedValue\": components.currencyInput1.formattedValue, \"currency\": components.currencyInput1.currency, \"label\": components.currencyInput1.label };",
