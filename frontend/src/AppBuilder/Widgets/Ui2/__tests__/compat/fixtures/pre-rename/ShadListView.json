        "code": "// Calls listView1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.listView1.selectItem(2);\nawait components.listView1.clearSelection();\nawait components.listView1.setPage(1);\nawait components.listView1.setLoading(true);\nawait components.listView1.setLoading(false);\nawait components.listView1.setDisable(true);\nawait components.listView1.setDisable(false);\nawait components.listView1.setVisibility(false);\nawait components.listView1.setVisibility(true);\nreturn { \"isVisible\": components.listView1.isVisible, \"isLoading\": components.listView1.isLoading, \"isDisabled\": components.listView1.isDisabled, \"data\": components.listView1.data, \"children\": components.listView1.children, \"selectedItem\": components.listView1.selectedItem, \"selectedItemId\": components.listView1.selectedItemId, \"selectedRecord\": components.listView1.selectedRecord, \"selectedRecordId\": components.listView1.selectedRecordId, \"selectedRow\": components.listView1.selectedRow, \"selectedRowId\": components.listView1.selectedRowId, \"pageIndex\": components.listView1.pageIndex };",
