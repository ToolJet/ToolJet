    {
      "id": "0732d2b2-ac96-5441-a941-6d125cc47948",
      "name": "callWidget",
      "kind": "runjs",
      "appVersionId": "f04b5e65-1a80-5379-aa91-504d1e23204e",
      "options": {
        "code": "// Calls textarea1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.textarea1.setText(\"Saved notes\");\nawait components.textarea1.clear();\nawait components.textarea1.setFocus();\nawait components.textarea1.setBlur();\nawait components.textarea1.setLoading(true);\nawait components.textarea1.setLoading(false);\nawait components.textarea1.disable(true);\nawait components.textarea1.disable(false);\nawait components.textarea1.setDisable(true);\nawait components.textarea1.setDisable(false);\nawait components.textarea1.visibility(false);\nawait components.textarea1.visibility(true);\nawait components.textarea1.setVisibility(false);\nawait components.textarea1.setVisibility(true);\nreturn { \"isVisible\": components.textarea1.isVisible, \"isLoading\": components.textarea1.isLoading, \"isDisabled\": components.textarea1.isDisabled, \"isValid\": components.textarea1.isValid, \"isMandatory\": components.textarea1.isMandatory, \"value\": components.textarea1.value, \"label\": components.textarea1.label };",
