      "options": {
        "code": "// Calls colorPicker1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.colorPicker1.setColor(\"#6366f1\");\nawait components.colorPicker1.setFocus();\nawait components.colorPicker1.setBlur();\nawait components.colorPicker1.setLoading(true);\nawait components.colorPicker1.setLoading(false);\nawait components.colorPicker1.setDisable(true);\nawait components.colorPicker1.setDisable(false);\nawait components.colorPicker1.setVisibility(false);\nawait components.colorPicker1.setVisibility(true);\nreturn { \"isVisible\": components.colorPicker1.isVisible, \"isLoading\": components.colorPicker1.isLoading, \"isDisabled\": components.colorPicker1.isDisabled, \"value\": components.colorPicker1.value, \"selectedColorRGB\": components.colorPicker1.selectedColorRGB, \"selectedColorRGBA\": components.colorPicker1.selectedColorRGBA, \"colorFormat\": components.colorPicker1.colorFormat, \"allowOpacity\": components.colorPicker1.allowOpacity, \"isValid\": components.colorPicker1.isValid, \"label\": components.colorPicker1.label };",
