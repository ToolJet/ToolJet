      "options": {
        "code": "// Calls checkbox1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.checkbox1.toggle();\nawait components.checkbox1.setValue(true);\nawait components.checkbox1.setLoading(true);\nawait components.checkbox1.setLoading(false);\nawait components.checkbox1.setDisable(true);\nawait components.checkbox1.setDisable(false);\nawait components.checkbox1.setVisibility(false);\nawait components.checkbox1.setVisibility(true);\nreturn { \"isVisible\": components.checkbox1.isVisible, \"isLoading\": components.checkbox1.isLoading, \"isDisabled\": components.checkbox1.isDisabled, \"isValid\": components.checkbox1.isValid, \"isMandatory\": components.checkbox1.isMandatory, \"value\": components.checkbox1.value, \"label\": components.checkbox1.label };",
