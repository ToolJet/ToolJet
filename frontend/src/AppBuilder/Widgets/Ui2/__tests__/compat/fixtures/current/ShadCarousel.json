        "code": "// Calls carousel1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.carousel1.next();\nawait components.carousel1.previous();\nawait components.carousel1.goTo(1);\nawait components.carousel1.setLoading(true);\nawait components.carousel1.setLoading(false);\nawait components.carousel1.setDisable(true);\nawait components.carousel1.setDisable(false);\nawait components.carousel1.setVisibility(false);\nawait components.carousel1.setVisibility(true);\nreturn { \"isVisible\": components.carousel1.isVisible, \"isLoading\": components.carousel1.isLoading, \"isDisabled\": components.carousel1.isDisabled, \"currentIndex\": components.carousel1.currentIndex, \"currentSlide\": components.carousel1.currentSlide, \"clickedSlide\": components.carousel1.clickedSlide };",
