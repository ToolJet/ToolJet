      "options": {
        "code": "// Calls slider1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.slider1.setValue(50);\nawait components.slider1.setRangeValue(20, 80);\nawait components.slider1.reset();\nawait components.slider1.setLoading(true);\nawait components.slider1.setLoading(false);\nawait components.slider1.setDisable(true);\nawait components.slider1.setDisable(false);\nawait components.slider1.setVisibility(false);\nawait components.slider1.setVisibility(true);\nreturn { \"isVisible\": components.slider1.isVisible, \"isLoading\": components.slider1.isLoading, \"isDisabled\": components.slider1.isDisabled, \"value\": components.slider1.value, \"label\": components.slider1.label };",
