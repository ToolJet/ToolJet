      "name": "callWidget",
      "kind": "runjs",
      "appVersionId": "9567a70a-3b2a-578a-ae3a-b40807086768",
      "options": {
        "code": "// Calls button1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.button1.click();\nawait components.button1.setText(\"New text\");\nawait components.button1.loading(true);\nawait components.button1.loading(false);\nawait components.button1.setLoading(true);\nawait components.button1.setLoading(false);\nawait components.button1.disable(true);\nawait components.button1.disable(false);\nawait components.button1.setDisable(true);\nawait components.button1.setDisable(false);\nawait components.button1.visibility(false);\nawait components.button1.visibility(true);\nawait components.button1.setVisibility(false);\nawait components.button1.setVisibility(true);\nreturn { \"isVisible\": components.button1.isVisible, \"isLoading\": components.button1.isLoading, \"isDisabled\": components.button1.isDisabled, \"buttonText\": components.button1.buttonText };",
