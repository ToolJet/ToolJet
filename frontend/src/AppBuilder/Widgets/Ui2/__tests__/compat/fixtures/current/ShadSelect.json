      "options": {
        "code": "// Calls select1's actions and reads its values by name, as RunJS code in a saved app does.\nawait components.select1.selectOption(2);\nawait components.select1.clear();\nawait components.select1.setFocus();\nawait components.select1.setBlur();\nawait components.select1.setLoading(true);\nawait components.select1.setLoading(false);\nawait components.select1.setDisable(true);\nawait components.select1.setDisable(false);\nawait components.select1.setVisibility(false);\nawait components.select1.setVisibility(true);\nreturn { \"isVisible\": components.select1.isVisible, \"isLoading\": components.select1.isLoading, \"isDisabled\": components.select1.isDisabled, \"isValid\": components.select1.isValid, \"isMandatory\": components.select1.isMandatory, \"value\": components.select1.value, \"selectedOption\": components.select1.selectedOption, \"options\": components.select1.options, \"label\": components.select1.label };",
