<!DOCTYPE html>
<html lang="en">

<head>
  <% if (process.env.NODE_ENV==='production' && process.env.SERVE_CLIENT !=='false' ) { %>
  <base href="__REPLACE_SUB_PATH__" />
  <% } else { %>
  <base href="/" />
  <% } %>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Loading...</title>

  <style>
    a {
      cursor: pointer;
    }

    body {
      margin: 0;
    }

    /* Boot loader. Also used by the LottieLoader React component, which renders the
       same animation once the app bundle takes over. */
    .tj-app-loader {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100vw;
      height: 100vh;
      background-color: #FCFCFD;
      margin: 0;
      overflow: hidden;
    }

    .tj-app-loader.dark-loader {
      background-color: #1E2226;
    }

    /* The artwork is a 16:9 export that letterboxes inside its box, so halving both
       dimensions halves the rendered animation regardless of the viewport aspect. */
    .tj-app-loader .loader-animation {
      width: 50%;
      height: 50%;
    }

    /* roboto-100 - latin */
    @font-face {
      font-display: swap;
      /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Roboto';
      font-style: normal;
      font-weight: 100;
      src: url('/assets/fonts/roboto-v30-latin/roboto-v30-latin-100.woff2') format('woff2');
      /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
    }

    /* roboto-300 - latin */
    @font-face {
      font-display: swap;
      /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Roboto';
      font-style: normal;
      font-weight: 300;
      src: url('/assets/fonts/roboto-v30-latin/roboto-v30-latin-300.woff2') format('woff2');
      /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
    }

    /* roboto-regular - latin */
    @font-face {
      font-display: swap;
      /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Roboto';
      font-style: normal;
      font-weight: 400;
      src: url('/assets/fonts/roboto-v30-latin/roboto-v30-latin-regular.woff2') format('woff2');
      /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
    }

    /* roboto-500 - latin */
    @font-face {
      font-display: swap;
      /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Roboto';
      font-style: normal;
      font-weight: 500;
      src: url('/assets/fonts/roboto-v30-latin/roboto-v30-latin-500.woff2') format('woff2');
      /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
    }

    /* source-code-pro-regular - latin */
    @font-face {
      font-display: swap;
      /* Check https://developer.mozilla.org/en-US/docs/Web/CSS/@font-face/font-display for other options. */
      font-family: 'Source Code Pro';
      font-style: normal;
      font-weight: 400;
      src: url('/assets/fonts/source-code-pro-v22-latin/source-code-pro-v22-latin-regular.woff2') format('woff2');
      /* Chrome 36+, Opera 23+, Firefox 39+, Safari 12+, iOS 10+ */
    }
  </style>

  <link rel="icon" href="assets/images/logo.svg" sizes="any" type="image/svg+xml" />
  <% if (process.env.TOOLJET_EDITION === 'cloud') { %>
  <script src="https://cdn.jsdelivr.net/pyodide/v0.23.2/full/pyodide.js"></script>
  <% } else { %>
  <script src="assets/libs/pyodide-0.23.2/pyodide.js"></script>
  <% } %>
</head>

<body>
  <div id="app">
    <div id="app-loader" class="tj-app-loader">
      <div id="app-loader-animation" class="loader-animation"></div>
    </div>
  </div>
</body>
<script src="assets/libs/lottie-5.13.0/lottie_light.min.js"></script>
<script>
  (function () {
    const darkModeEnabled = typeof localStorage !== 'undefined' && localStorage.getItem('darkMode') === 'true';
    const loaderElement = document.getElementById('app-loader');
    if (darkModeEnabled) {
      loaderElement.classList.add('dark-loader');
    }

    const container = document.getElementById('app-loader-animation');
    if (!container || !window.lottie) return;

    const animation = window.lottie.loadAnimation({
      container: container,
      renderer: 'svg',
      loop: true,
      autoplay: true,
      path: darkModeEnabled ? 'assets/lottie/app-loader-dark.json' : 'assets/lottie/app-loader-light.json',
    });

    // React renders into #app and wipes the loader markup on mount. Without this the
    // animation keeps ticking on a detached DOM node for the rest of the session.
    const appElement = document.getElementById('app');
    const observer = new MutationObserver(function () {
      if (!document.getElementById('app-loader')) {
        animation.destroy();
        observer.disconnect();
      }
    });
    observer.observe(appElement, { childList: true });
  })();
</script>
</html>
