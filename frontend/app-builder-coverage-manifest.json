{
  "version": 1,
  "boundary": {
    "include": "src/AppBuilder/**/*.{js,jsx,ts,tsx}",
    "structuralExclusions": ["__tests__", "__mocks__", "stories", "test-fixtures", ".d.ts"]
  },
  "target": { "lines": 80, "branches": 80, "enforcement": "report-only" },
  "editions": ["ce", "ee"],
  "subsystems": [
    { "id": "loading-versions-compatibility", "name": "Loading, versions, and compatibility", "owner": "", "roots": ["Header/AppVersionsManager", "Header/EnvironmentManager", "Header/VersionManager"] },
    { "id": "bindings-evaluation-state", "name": "Bindings, evaluation, and state", "owner": "", "roots": ["CodeBuilder", "CodeEditor", "_contexts", "_helpers", "_hooks", "_stores", "_utils"] },
    { "id": "queries-events-actions-exposed-values", "name": "Queries, events, actions, and exposed values", "owner": "", "roots": ["QueryManager", "QueryPanel"] },
    { "id": "canvas-layout-interaction-reflow", "name": "Canvas layout, interaction, and reflow", "owner": "", "roots": ["AppCanvas"] },
    { "id": "widget-definitions-runtime", "name": "Widget definitions and runtime", "owner": "", "roots": ["WidgetManager", "Widgets"] },
    { "id": "inspector-configuration", "name": "Inspector and configuration", "owner": "", "roots": ["RightSideBar"] },
    { "id": "persistence-import-export", "name": "Persistence, import, and export", "owner": "", "roots": [] },
    { "id": "editor-viewer", "name": "Editor and Viewer", "owner": "", "roots": ["Viewer"] },
    { "id": "collaboration-history", "name": "Collaboration and history", "owner": "", "roots": ["RealTimeEditor"] },
    { "id": "builder-shell", "name": "Builder shell", "owner": "", "roots": ["Header", "LeftSidebar", "Popups", "Shared"], "files": ["AppBuilder.jsx", "Cursor.jsx", "EmbedApp.jsx", "RealtimeCursors.jsx", "index.js"] }
  ],
  "overrides": {
    "src/AppBuilder/_stores/slices/appSlice.js": "persistence-import-export",
    "src/AppBuilder/_stores/slices/appVersionSlice.js": "loading-versions-compatibility",
    "src/AppBuilder/_stores/slices/environmentsAndVersionsSlice.js": "loading-versions-compatibility",
    "src/AppBuilder/_stores/slices/loaderSlice.js": "loading-versions-compatibility",
    "src/AppBuilder/_stores/slices/dataQuerySlice.js": "queries-events-actions-exposed-values",
    "src/AppBuilder/_stores/slices/dataQueryFolderSlice.js": "queries-events-actions-exposed-values",
    "src/AppBuilder/_stores/slices/dataSourceSlice.js": "queries-events-actions-exposed-values",
    "src/AppBuilder/_stores/slices/eventsSlice.js": "queries-events-actions-exposed-values",
    "src/AppBuilder/_stores/slices/queryPanelSlice.js": "queries-events-actions-exposed-values",
    "src/AppBuilder/_stores/slices/gridSlice.js": "canvas-layout-interaction-reflow",
    "src/AppBuilder/_stores/slices/layoutSlice.js": "canvas-layout-interaction-reflow",
    "src/AppBuilder/_stores/slices/inspectorSlice.js": "inspector-configuration",
    "src/AppBuilder/_stores/slices/rightSideBarSlice.js": "inspector-configuration",
    "src/AppBuilder/_stores/slices/undoRedoSlice.js": "collaboration-history",
    "src/AppBuilder/_stores/slices/multiplayerSlice.js": "collaboration-history"
  },
  "exceptions": []
}
