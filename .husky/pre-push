# Verify submodule cleanliness/pointer/push parity and lint before pushing.
# Unit/e2e tests are not run here — CI's test-changed lane gates the PR on those.
# Emergency bypass: git push --no-verify

# Drain the ref list git writes on stdin; leaving it unread can EPIPE/SIGPIPE the
# parent git process after a long-running hook, killing the push post-verification.
cat > /dev/null

# Git hooks run with a minimal environment — put the dev's node/npm on PATH
# so eslint can resolve the workspaces' node_modules.
if [ -s "$HOME/.nvm/nvm.sh" ]; then
  . "$HOME/.nvm/nvm.sh" >/dev/null 2>&1 || true
fi
command -v node >/dev/null 2>&1 || export PATH="$PATH:/usr/local/bin:/opt/homebrew/bin"

bash scripts/verify-submodules-and-lint.sh

