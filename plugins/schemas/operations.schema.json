{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Operations schema",
  "description": "Tooljet Operations schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path to the JSON-schema to use for this file"
    },
    "title": {
      "type": "string",
      "description": "title of datasource"
    },
    "description": {
      "type": "string",
      "description": "description of datasource"
    },
    "type": {
      "anyOf": [
        {
          "$ref": "#/definitions/pluginType"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pluginType"
          }
        }
      ]
    },
    "defaults": {
      "type": "object"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "definitions": {
    "node": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "anyOf": [
                {
                  "enum": [
                    "checkbox-group",
                    "codehinter",
                    "columns",
                    "dropdown",
                    "dropdown-component-flip",
                    "dynamic-selector",
                    "filters",
                    "react-component-api-endpoint",
                    "react-component-api-endpoint-old",
                    "react-component-headers",
                    "react-component-key-value-tabs",
                    "react-component-sort",
                    "react-component-sql-aggregate",
                    "react-component-sql-columns",
                    "react-component-sql-filters",
                    "react-component-sql-groupby",
                    "react-component-sql-sort",
                    "sorts",
                    "toggle"
                  ]
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/node"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      ]
    },
    "pluginType": {
      "enum": [
        "api",
        "cloud-storage",
        "database"
      ]
    }
  }
}
