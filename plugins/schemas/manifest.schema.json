{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Manifest schema",
  "description": "Tooljet manifest schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path to the JSON-schema to use for this file"
    },
    "title": {
      "type": "string",
      "description": "title of datasource"
    },
    "description": {
      "type": "string",
      "description": "description of datasource"
    },
    "type": {
      "anyOf": [
        {
          "$ref": "#/definitions/pluginType"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/pluginType"
          }
        }
      ]
    },
    "defaults": {
      "type": "object"
    },
    "source": {
      "type": "object",
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        }
      }
    },
    "tj:source": {
      "$ref": "#/properties/source"
    },
    "properties": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/node"
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "source"
      ]
    },
    {
      "required": [
        "tj:source"
      ]
    }
  ],
  "definitions": {
    "node": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "anyOf": [
                {
                  "enum": [
                    "array",
                    "boolean",
                    "dropdown",
                    "dropdown-component-flip",
                    "dynamic-selector",
                    "number",
                    "password",
                    "react-component-google-sheets",
                    "react-component-headers",
                    "react-component-oauth",
                    "react-component-oauth-authentication",
                    "react-component-openapi-validator",
                    "react-component-sharepoint",
                    "react-component-slack",
                    "react-component-zendesk",
                    "react-form-component",
                    "string",
                    "text",
                    "textarea",
                    "toggle"
                  ]
                },
                {
                  "type": "object"
                }
              ]
            }
          },
          "additionalProperties": {
            "$ref": "#/definitions/node"
          }
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/node"
          }
        },
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        }
      ]
    },
    "pluginType": {
      "enum": [
        "ai",
        "api",
        "cloud-storage",
        "database",
        "object"
      ]
    }
  }
}
