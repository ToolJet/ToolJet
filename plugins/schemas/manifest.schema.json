{
  "$schema": "http://json-schema.org/draft-07/schema",
  "title": "Manifest schema",
  "description": "Tooljet manifest schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string",
      "description": "path to the JSON-schema to use for this file"
    },
    "title": {
      "type": "string",
      "description": "title of datasource"
    },
    "description": {
      "type": "string",
      "description": "description of datasource"
    },
    "type": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/type"
      }
    },
    "defaults": {
      "type": "object",
      "description": "Option values seeded when a data source of this kind is first created, keyed by option name.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "description": "Base default value for the option."
          },
          "encrypted": {
            "type": ["boolean", "string"]
          },
          "editions": {
            "type": "object",
            "description": "Optional per-edition override of `value`. When the running edition has an entry here, that value is seeded instead of `value`. Resolved on the frontend by resolveEditionSpecificDefaults (frontend/src/_helpers/utils.js).",
            "properties": {
              "ce": {},
              "ee": {},
              "cloud": {}
            },
            "additionalProperties": false
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "exposedVariables": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "isLoading": {
              "type": "string"
            },
            "data": {
              "type": "string"
            },
            "rawData": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "definitions": {
    "type": {
      "enum": [
        "api",
        "cloud-storage",
        "database"
      ]
    }
  }
}