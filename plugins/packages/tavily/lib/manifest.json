{
  "$schema": "https://raw.githubusercontent.com/ToolJet/ToolJet/develop/plugins/schemas/manifest.schema.json",
  "title": "Tavily datasource",
  "description": "AI-native search and web extraction engine optimized for LLMs",
  "type": "api",
  "source": {
    "name": "Tavily",
    "kind": "tavily",
    "exposedVariables": {
      "isLoading": false,
      "data": {},
      "rawData": {}
    },
    "options": {
      "api_key": {
        "type": "string",
        "encrypted": true
      },
      "base_url": {
        "type": "string"
      }
    },
    "customTesting": true
  },
  "defaults": {
    "api_key": {
      "value": ""
    },
    "base_url": {
      "value": ""
    }
  },
  "properties": {
    "api_key": {
      "label": "API key",
      "key": "api_key",
      "type": "password",
      "description": "Tavily API key"
    },
    "base_url": {
      "label": "Base URL",
      "key": "base_url",
      "type": "text",
      "description": "Defaults to https://api.tavily.com"
    }
  },
  "required": [
    "api_key"
  ]
}
